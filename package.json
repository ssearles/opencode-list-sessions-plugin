{
  "name": "opencode-archive-session",
  "version": "0.2.0",
  "description": "OpenCode plugin to archive, list, read, save and restore sessions. Forked from opencode-session-transcript, reviving the archive tooling that was dropped there.",
  "keywords": [
    "archive",
    "markdown",
    "opencode",
    "opencode-plugin",
    "restore",
    "session",
    "transcript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src/",
    "popup/session-list-popup"
  ],
  "scripts": {
    "test": "node --test test/ && npm run test:popup",
    "test:plugin": "node --test test/",
    "test:popup": "python3 popup/test-popup-writes.py && python3 popup/test-popup-lifecycle.py && python3 popup/test-popup-gui.py",
    "install:popup": "ln -sf \"$PWD/popup/session-list-popup\" \"$HOME/.local/bin/session-list-popup\"",
    "check": "node -e \"Promise.all([import('./index.ts'),import('./src/db.ts')]).then(()=>console.log('modules load OK')).catch(e=>{console.error(e);process.exit(1)})\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssearles/opencode-archive-session.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
