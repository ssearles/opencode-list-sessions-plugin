# Mirrors shortDir() in the plugin: last two path segments.
SHORT_DIR_MAX = 2

# Custom response ids for the delete confirmation. Gtk.ResponseType in GTK3 has
# no DELETE, and pinning "Archive instead" to ACCEPT and "Delete" to REJECT
# makes the handler read as though the two meanings were swapped.
RESP_ARCHIVE_INSTEAD = 1
RESP_DELETE = 2


def short_dir(directory: str) -> str:
    parts = [p for p in (directory or "").split("/") if p]
    return "/".join(parts[-SHORT_DIR_MAX:]) if parts else "-"


def short_home(path: Path) -> str:
    """A path with the home directory shown as ~, so it is readable at width."""
    home = str(Path.home())
    text = str(path)
    return "~" + text[len(home):] if text.startswith(home) else text


def slug_of(title: str | None) -> str:
    """
    A filesystem-safe stem from a session title.

    Titles are prose -- they carry punctuation, slashes and quotes -- so they
    cannot go into a filename as they are. The mapping is lossy and that is
    accepted: the collision it allows between two similarly-titled sessions is
    reported by the caller rather than prevented, because uniqueness would mean
    inventing names the user did not ask for.
    """
    slug = "".join(c if c.isalnum() or c in "-_" else "-" for c in (title or "")).strip("-")
    return slug or "session"


def by_name(rows: list[dict]) -> list[dict]:
    """
    Sort session rows by title, the way the window lists them.

    Case-insensitive, so "apple" and "Banana" do not file under two different
    letters. Untitled sessions sort last rather than first, since an empty
    title would otherwise beat every real one on the alphabet. `id` breaks the
    final tie: titles repeat, and a list that reorders itself on every write is
    unreadable while you are reaching for a row in it.
    """
    return sorted(
        rows,
        key=lambda d: (
            not (d.get("title") or "").strip(),
            (d.get("title") or "").strip().lower(),
            d.get("id") or "",
        ),
    )


SORTS = (
