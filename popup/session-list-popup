def load_font_size() -> int:
    """The saved text size, or the default if it is absent or nonsense."""
    try:
        value = int(FONT_PREFS.read_text().strip())
    except (OSError, ValueError):
        return FONT_DEFAULT
    return max(FONT_MIN, min(FONT_MAX, value))


def save_font_size(size: int) -> None:
    """Remember the size for the next window. Never fatal."""
    try:
        FONT_PREFS.parent.mkdir(parents=True, exist_ok=True)
        FONT_PREFS.write_text(f"{size}\n")
    except OSError:
        pass


