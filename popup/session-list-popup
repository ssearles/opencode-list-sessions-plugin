class StatsWindow(Gtk.Window):
    """
    A read-only report in its own window, for one session or the whole store.

    Separate from the inventory rather than a strip or a dialog, because these
    are numbers you read rather than act on: nothing here writes, and nothing
    here should be one click from Delete.

    Sections are `Gtk.Expander`s rather than one long block of text. The report
    is mostly long lists -- tools, files, models -- and the three numbers that
    give it its meaning are at the top, buried under a scrollbar of file paths.
    Folding the long ones means the overview is readable without scrolling and
    the detail is one click away, which is the opposite trade to a flat report.

    Long sections start folded and short ones open, by line count rather than
    by name, so the rule needs no maintenance as sections are added.
    """

    def __init__(self, title: str, sections: list[tuple[str, str]],
                 subtitle: str = ""):
        super().__init__(title=title)
        # Use DIALOG hint so Wayland compositors (Hyprland) center it
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self._sections = sections
        self.font_size = load_font_size()
        self._text_views: list[Gtk.TextView] = []
        self._css_provider: Gtk.CssProvider | None = None

        screen = Gdk.Screen.get_default()
        if screen is not None:
            sw, sh = screen.get_width(), screen.get_height()
            self.set_default_size(min(880, int(sw * 0.7)), min(760, int(sh * 0.84)))

        # Center on screen (GTK WindowPosition.CENTER works on X11/Wayland)
        self.set_position(Gtk.WindowPosition.CENTER)
        # Stay above other windows, behave like a popup
        self.set_keep_above(True)

        # Same size the main window is using, so a report opened after pressing A+
        # does not come back at the old one. The report is a table of numbers
        # read at a glance -- exactly the content that suffers most from being
        # too small -- and it is the second window anyone opens.
        css = Gtk.CssProvider()
        css.load_from_data(scaled_css(CSS, load_font_size()))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)

        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        head.get_style_context().add_class("banner")
        t = Gtk.Label(label=title)
        t.get_style_context().add_class("banner-title")
        t.set_xalign(0)
        t.set_ellipsize(3)
        head.pack_start(t, False, False, 0)
        if subtitle:
            s = Gtk.Label(label=subtitle)
            s.get_style_context().add_class("banner-hint")
            s.set_xalign(0)
            s.set_ellipsize(3)
            head.pack_start(s, False, False, 0)
        root.pack_start(head, False, False, 0)

        # One TextView per section rather than one for the lot, so folding a
        # section folds its text with it. They are inside a single scroller, so
        # the whole report still scrolls as one column.
        #
        # Content is a string for most sections and a list of
        # (heading, rows) for the file lists, which get a nested expander per
        # directory. That nested expander IS the dropdown for a long list: the
        # directories and their totals are all visible, and the filenames under
        # one are a click away, rather than 200 rows of paths to scroll past.
        self._expanders: list[Gtk.Expander] = []
        stack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        for heading, content in sections:
            if not heading:
                stack.pack_start(self._content(content), False, False, 0)
                continue
            exp = Gtk.Expander(label=heading)
            exp.get_style_context().add_class("stat-section")
            plain = _as_text(content)
            exp.set_expanded(bool(plain) and len(plain.splitlines())
                             <= FOLD_AFTER_LINES)
            exp.add(self._content(content))
            stack.pack_start(exp, False, False, 0)
            self._expanders.append(exp)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroller.add(stack)
        root.pack_start(scroller, True, True, 0)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.get_style_context().add_class("hintbar")
        self.status = Gtk.Label(label="Nothing here writes to the database.")
        self.status.get_style_context().add_class("hintbar-label")
        self.status.set_xalign(0)
        self.status.set_ellipsize(3)
        footer.pack_start(self.status, True, True, 0)

        for label, wanted in (("Collapse all", False), ("Expand all", True)):
            btn = Gtk.Button(label=label)
            btn.connect("clicked", lambda *_, w=wanted: self._set_all(w))
            footer.pack_end(btn, False, False, 0)

        copy = Gtk.Button(label="Copy")
        copy.set_tooltip_text(
            "Copy the whole report -- folded sections included -- so it can be "
            "pasted into a note.")
        copy.connect("clicked", self._on_copy)
        footer.pack_end(copy, False, False, 0)

        # A-, A+ and Reset, matching the main window so the
        # two behave the same way in the same place.
        smaller = Gtk.Button(label="A-")
        smaller.set_tooltip_text(
            f"Smaller text. Also Ctrl+minus. Smallest is {FONT_MIN}px.")
        smaller.connect("clicked", lambda *_: self.set_font_size(self.font_size - FONT_STEP))
        footer.pack_end(smaller, False, False, 0)

        bigger = Gtk.Button(label="A+")
        bigger.set_tooltip_text(
            f"Bigger text. Also Ctrl+plus. Largest is {FONT_MAX}px.")
        bigger.connect("clicked", lambda *_: self.set_font_size(self.font_size + FONT_STEP))
        footer.pack_end(bigger, False, False, 0)

        reset_size = Gtk.Button(label="Reset size")
        reset_size.set_tooltip_text(
            f"Back to the default {FONT_DEFAULT}px. Also Ctrl+0.")
        reset_size.connect("clicked", lambda *_: self.set_font_size(FONT_DEFAULT))
        footer.pack_end(reset_size, False, False, 0)

        close = Gtk.Button(label="Close")
        close.get_style_context().add_class("footer-label")
        close.connect("clicked", lambda *_: self.destroy())
        footer.pack_end(close, False, False, 0)
        root.pack_start(footer, False, False, 0)

        self.show_all()

    @staticmethod
    def _view(body: str, font_size: int) -> Gtk.TextView:
        view = Gtk.TextView()
        view.set_editable(False)
        view.set_cursor_visible(False)
        view.set_wrap_mode(Gtk.WrapMode.NONE)
        view.set_left_margin(10)
        view.set_right_margin(10)
        view.set_top_margin(4)
        view.set_bottom_margin(4)
        view.get_buffer().set_text(body)
        view.get_style_context().add_provider(
            _report_provider(font_size), Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        return view

    def _add_text_view(self, view: Gtk.TextView) -> None:
        """Track text views so they can be updated when font size changes."""
        self._text_views.append(view)
        return view

    def _content(self, content) -> Gtk.Widget:
        """A TextView for text, or a folded group per directory for file lists."""
        if isinstance(content, str):
            return self._add_text_view(self._view(content, self.font_size))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        for label, rows in content:
            # Each directory starts folded. Opened all at once it is the same
            # wall of rows the grouping was meant to fix.
            exp = Gtk.Expander(label=label)
            exp.get_style_context().add_class("stat-group")
            exp.set_expanded(False)
            exp.add(self._add_text_view(self._view("\n".join(rows), self.font_size)))
            box.pack_start(exp, False, False, 0)
        return box

    def _set_all(self, expanded: bool) -> None:
        for exp in self._expanders:
            exp.set_expanded(expanded)
        self.status.set_text(
            "Every section is open." if expanded
            else "Every section is folded away.")

    def set_font_size(self, size: int) -> None:
        """Set the font size for the report text."""
        size = max(FONT_MIN, min(FONT_MAX, size))
        if size == self.font_size:
            return
        self.font_size = size
        save_font_size(size)

        # Update CSS only for tracked TextViews in this window
        css = Gtk.CssProvider()
        css.load_from_data(scaled_css(REPORT_CSS, self.font_size))
        for view in self._text_views:
            context = view.get_style_context()
            context.remove_provider(self._css_provider) if self._css_provider else None
            context.add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self._css_provider = css

    def _on_copy(self, *_args) -> None:
        """Copy through wl-copy, for the reason the main window does."""
        proc = subprocess.run(
            ["wl-copy"], input=report_text(self._sections).encode("utf8"),
            capture_output=True, check=False)
        self.status.set_text(
            "Copied the report." if proc.returncode == 0
            else "Could not copy - is wl-copy installed?")


_REPORT_PROVIDER = None


def _report_provider(size: int) -> Gtk.CssProvider:
    """
    One provider per font size: the report CSS is small and constant.

    A provider per size avoids the issue of a stale cached provider.
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(scaled_css(REPORT_CSS, size))
    return provider


REPORT_CSS = b"""
textview { font-family: monospace; font-size: 11px; }
expander.stat-section > box > label { font-weight: 700; font-size: 11px; }
expander.stat-group > box > label { font-size: 10px; color: #444444; }
expander.stat-group textview { font-size: 10px; }
"""


# The banner's width, in PIXELS, and how many characters that is.
#
# This is what sizes the window. An unwrapped Gtk.Label asks for its longest
# line, and any child asking for more than `set_default_size` wins -- which is
# how a five-paragraph banner opened this window at 2092px on a 1366px screen.
#
# It has to be **pixels**, not a fixed character count. `width_chars` counts
# characters, so a constant 150 chars is ~1078px at 11px and ~3900px at 40px:
# adding the text-size buttons quietly turned the banner back into a width
# control and a window opened at a large saved size came out 3778px wide.
# Deriving the count from the font keeps the physical width constant, and the
# banner wraps into more lines as the text grows, which is the right way round.
BANNER_PIXELS = 1000
# The banner's tallest it is ever allowed to make the window, in pixels. Beyond
# this it scrolls internally. Sized to hold four short paragraphs at the default
# font with room to spare, so it is invisible until the text is large.
BANNER_MAX_H = 220
# Measured on the default font: a character is about 0.65px per px of font
# size. Only the ratio matters -- test-popup-gui.py asserts the window fits the
# screen rather than trusting either number here.
BANNER_PX_PER_CHAR = 0.65 * FONT_DEFAULT


def banner_cols(font_size: int) -> int:
    """
    The character count whose pixel width is `BANNER_PIXELS` at this font size.

    The banner is what sizes the window, and `set_width_chars` counts
    characters -- so a constant char count is a *pixel* width that moves with
    the font. At 40px the banner asked for 3778px on a 1366px screen.

    Floored at 40 characters so a very large font wraps rather than asking for
    a zero-width label.
    """
    per_char = max(1.0, BANNER_PX_PER_CHAR * font_size / FONT_DEFAULT)
    return max(40, int(BANNER_PIXELS / per_char))


def scaled_css(css: bytes, size: int) -> bytes:
    """
    The same stylesheet with every `font-size: Npx` multiplied by the scale.

    One stylesheet scaled, rather than a stylesheet per size. The alternative
    -- keeping a dict of variants -- means every font-size added to the CSS
    afterwards is wrong in every variant but one, and nothing says so.

    Rounding is up to a whole pixel and the scale is clamped to 1/8 of a pixel,
    so a size of 7 does not collapse the 9px chip to 1px. Sizes below
    FONT_MIN/FONT_MAX never reach here, but the function is not allowed to
    depend on its caller having checked.
    """
    scale = max(0.125, size / FONT_DEFAULT)

    def bump(match: "re.Match[bytes]") -> bytes:
        return (match.group(1)
                + str(max(1, round(int(match.group(2)) * scale))).encode("ascii")
                + match.group(3))

    return _SIZE_RE.sub(bump, css)


def _short(text: str, limit: int) -> str:
    """Trim from the left, keeping the end -- which for a path is the filename."""
    return text if len(text) <= limit else "…" + text[-(limit - 1):]


def _counter_rows(counter, limit: int = 12) -> list[str]:
    """
    The top entries of a Counter (or a plain dict of counts) as aligned lines.

    Accepts a dict because some of these are handed over already converted --
    a report that cannot show a model because the value was flattened one step
    too early is a silly failure to debug.
    """
    items = (sorted(counter.items(), key=lambda kv: -kv[1])
             if isinstance(counter, dict) else counter.most_common(limit))
    if not items:
        return ["  (none)"]
    top = items[:limit]
    # Paths are shortened from the left, keeping the tail. A truncated path that
    # loses its filename loses the part that tells two files apart, and two
    # sessions' worth of `Default Project/...` rows are indistinguishable
    # otherwise. Tool names are short and pass through unchanged.
    out = [f"  {_short(str(name), 46):<46} {count:>7,}" for name, count in top]
    if len(items) > limit:
        out.append(f"  ... and {len(items) - limit} more")
    return out


def group_by_directory(paths) -> list[tuple[str, list[str]]]:
    """
    (directory heading, filename rows) pairs, heaviest directory first.

    The flat form -- one truncated path per line -- was unreadable for a reason
    worth recording. `_short` keeps the tail, so the leading `…` ate the part
    that says WHICH PROJECT, and two rows both starting `…fault Project/` were
    indistinguishable. A truncated path that cannot be told apart from another
    truncated path is worse than a long one.

    So the directory goes on its own line, in full, and the filenames sit under
    it. That is also how you would say it out loud when asked what a session
    touched.
    """
    groups: dict[str, Counter] = {}
    for path, count in paths.items():
        directory, _, name = str(path).rpartition("/")
        groups.setdefault(directory or ".", Counter())[name] += count
    out = []
    for directory, names in sorted(groups.items(),
                                   key=lambda kv: (-sum(kv[1].values()), kv[0])):
        rows = [f"  {name:<46} {n:>6,}" for name, n in
                sorted(names.items(), key=lambda kv: (-kv[1], kv[0]))]
        total = sum(names.values())
        out.append((
            f"{directory}/  —  {len(names)} file"
            f"{'' if len(names) == 1 else 's'}, {total:,} touches",
            rows,
        ))
    return out


USB_CLASSES = (
    (20000, "USB 3.2 Gen2x2"),
    (10000, "USB 3.2 Gen2"),
    (5000, "USB 3.0 / 3.2 Gen1"),
    (480, "USB 2.0"),
    (12, "USB 1.1"),
    (1, "USB 1.0"),
)


def usb_links() -> list[dict]:
    """
    USB ports and the speed they negotiated, from sysfs.

    Not an OpenCode stat, and worth saying so — but it is the answer to "why is
    this file slow", which arrives looking exactly like "OpenCode is hanging".
    A 3GB read off USB 2.0 takes minutes; off a 5Gbps port it takes seconds,
    and nothing on screen tells you which of the two you have.

    `lsusb -t` answers this too and is not installed. sysfs answers it without
    a dependency, and `/sys/devices/.../2-2/.../block/sdb` carries the port in
    the path, so a disk's port is a string operation rather than a second tool.

    Controller roots are skipped: `usb1` and `usb2` report the controller's
    maximum, not what anything plugged into it achieved, so listing them claims
    a USB 3.0 port exists whether or not one is in use.
    """
    root = Path("/sys/bus/usb/devices")
    if not root.is_dir():
        return []
    out: list[dict] = []
    seen: set[str] = set()
    try:
        entries = sorted(root.iterdir())
    except OSError:
        return []

    for entry in entries:
        # `usbN` is a controller root: it reports the controller's maximum, not
        # what anything plugged into it achieved, so listing it claims a USB 3.0
        # port exists whether or not one is in use.
        if not entry.is_dir() or entry.name.startswith("usb"):
            continue
        # A device is `bus-port` and its interfaces are `bus-port:iface`. The
        # port carries the speed and the product; its interfaces usually repeat
        # them. Take the port, once.
        port_name = entry.name.split(":")[0]
        if port_name in seen:
            continue
        # `speed` is required; `product` is not. Reading both inside one try
        # discarded the whole port when a device had no product string --
        # and FileNotFoundError is an OSError, so a USB 1.1 dongle that had a
        # speed quietly vanished from the report because its name file was
        # missing.
        try:
            speed = int((entry / "speed").read_text().strip())
        except (OSError, ValueError):
            continue
        try:
            product = (entry / "product").read_text().strip()
        except OSError:
            product = ""
        seen.add(port_name)
        out.append({
            "port": port_name,
            "mbps": speed,
            "kind": next((label for floor, label in USB_CLASSES
                          if speed >= floor), f"{speed} Mbps"),
            "product": product or "(no product string)",
        })

    mounts: dict[str, str] = {}
    try:
        for line in Path("/proc/mounts").read_text().splitlines():
            parts = line.split()
            if len(parts) > 1 and parts[0].startswith("/dev/"):
                mounts.setdefault(os.path.basename(parts[0]), parts[1])
    except OSError:
        pass

    blocks = Path("/sys/class/block")
    if blocks.is_dir():
        try:
            disks = sorted(blocks.glob("*"))
        except OSError:
            disks = []
        for link in disks:
            if link.name.startswith(("loop", "ram", "zram", "dm-")):
                continue
            try:
                resolved = str(link.resolve())
            except OSError:
                continue
            for port in out:
                if f"/{port['port']}/" in resolved:
                    port["block"] = link.name
                    if link.name in mounts:
                        port["mount"] = mounts[link.name]
                    break
    return out


def _meminfo() -> dict:
    """Total and available memory in MB, from /proc/meminfo."""
    out: dict = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, _, rest = line.partition(":")
            if key in ("MemTotal", "MemAvailable", "SwapTotal"):
                out[key] = int(rest.split()[0]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    return out


def _cpu_info() -> dict:
    """
    What the CPU actually is, and how much of it there really is.

    `os.cpu_count()` returns **logical** processors, so a 2-core chip with
    hyperthreading reports 4 and the report says "4 cpus". That is the number
    that matters least: parallel work gets two cores' throughput, not four, and
    on a low-power laptop part the gap between "4" and "2 real cores at 2GHz"
    is most of why a heavy task feels slow here. Both counts, and the model
    name, because the model is the one that tells you what to expect.

    `/proc/cpuinfo` rather than `lscpu`: `lscpu` is installed here and is the
    tidier answer, but forking it on a button click is the same cost as the
    `opencode --version` probe this deliberately does not do. cpuinfo needs no
    dependency and no fork, and its field names are stable across every
    architecture that has them.

    ARM does not call it `model name`, so the label is probed in order and the
    machine gets whatever it has rather than a blank.
    """
    out: dict = {"logical": os.cpu_count()}
    try:
        text = Path("/proc/cpuinfo").read_text()
    except OSError:
        return out

    blocks = [b for b in text.split("\n\n") if b.strip()]
    fields = []
    for block in blocks:
        parsed = {}
        for line in block.splitlines():
            if ":" in line:
                key, value = line.split(":", 1)
                parsed[key.strip()] = value.strip()
        fields.append(parsed)

    # Model name on x86; ARM says `Hardware`, and some boards say `Model`.
    for key in ("model name", "Hardware", "Model", "cpu model"):
        for parsed in fields:
            if parsed.get(key):
                out["model"] = parsed[key]
                break
        if "model" in out:
            break

    # Physical cores from the (package, core) pairs, which is what `cpu cores`
    # reports and what `cpu_count()` does not. Absent on some ARM boards, in
    # which case the logical count stands and is not second-guessed.
    pairs = {(p["physical id"], p["core id"]) for p in fields
             if "core id" in p and "physical id" in p}
    if pairs:
        out["cores"] = len(pairs)

    speeds = {p["cpu MHz"] for p in fields if "cpu MHz" in p}
    if speeds:
        out["mhz"] = max(float(s) for s in speeds)
    caches = {p["cache size"] for p in fields if "cache size" in p}
    if caches:
        out["cache"] = sorted(caches)[0]

    out["arch"] = os.uname().machine
    return out


# Vendors ship placeholder values in fields they never populated, and those
# are worse than absent because they read as an answer.
DMI_PLACEHOLDERS = {
    "to be filled by o.e.m.", "to be filled by oem", "to be filled by oem.",
    "default string", "none", "unknown", "not applicable", "n/a",
    "system serial number", "system manufacturer", "system product name",
    "system version", "defaulted", "oem", "o.e.m.",
}


def _dmi_value(value: str) -> str:
    """
    A DMI string field, or "" when the vendor left a placeholder in it.

    Its own function for the same reason `_file_version` is: the placeholder
    rule can only be tested against fixtures if it can be called on something
    other than this machine, whose DMI fields are all genuinely populated --
    so a test that reads the live ones passes against code that accepts
    "To Be Filled By O.E.M." as a vendor.
    """
    value = value.strip()
    return "" if value.lower() in DMI_PLACEHOLDERS else value


def _machine_info() -> dict:
    """
    The machine itself: make, model, and whether it is a laptop.

    DMI, from sysfs, no dependency and no fork. `hostnamectl` would be tidier
    and `upower` would give a warranty-expiry date, but both are daemons or
    D-Bus clients on a button click.

    **Serial and UUID are deliberately not read.** They are the two DMI fields
    that identify *this* machine rather than describing it, this window's
    report can be copied out of it, and a serial number is the one figure here
    that nobody troubleshooting a slow build needs.

    Vendors ship placeholder values in fields they never populated —
    "To Be Filled By O.E.M.", "Default string", "None", "Unknown" — and those
    are worse than absent because they read as an answer.

    The marketing name is in `product_version`, not `product_name`: this
    machine reports `product_name = 80SA` (the type number) and
    `product_version = Lenovo ideapad FLEX 4-1470`. Taking the first would put
    a bare code where the model should be.
    """
    root = Path("/sys/class/dmi/id")
    if not root.is_dir():
        return {}

    def field(name: str) -> str:
        try:
            return _dmi_value((root / name).read_text())
        except OSError:
            return ""

    out: dict = {}
    vendor = field("sys_vendor")
    # product_version is the marketing name on Lenovo; on Dell and HP the
    # human-readable one is product_name, and on others both are codes. Prefer
    # whichever looks like a name rather than a type number.
    version, name = field("product_version"), field("product_name")
    model = version if _looks_like_model(version, name) else name
    if vendor:
        out["vendor"] = vendor
    if model:
        out["model"] = model
    if name and name != model:
        out["type"] = name
    board = field("board_name")
    if board and board != model:
        out["board"] = board
    bios = field("bios_version")
    if bios:
        out["bios"] = bios
    chassis = field("chassis_type")
    if chassis:
        out["chassis"] = CHASSIS_TYPES.get(chassis, f"type {chassis}")
    return out


# SMBIOS chassis type, which is how a script learns "this is a laptop" without
# asking. The number is stable; the name is from the SMBIOS spec.
CHASSIS_TYPES = {
    "3": "desktop", "4": "low-profile desktop", "5": "pizza box",
    "6": "mini tower", "7": "tower", "8": "portable",
    "9": "laptop", "10": "notebook", "11": "hand held",
    "13": "all in one", "14": "sub notebook", "30": "tablet",
    "31": "convertible", "32": "detachable",
}


def _looks_like_model(version: str, name: str) -> bool:
    """
    Whether product_version reads like a model rather than a type number.

    Vendors split the fields differently and the codes are short and
    alphanumeric: `80SA` is a Lenovo type number, `ideapad FLEX 4-1470` is
    the model a person would recognise. A short code with no spaces in either
    field means neither is a name.
    """
    if version and " " in version:
        return True
    if name and " " in name:
        return False
    return False


def _cpu_summary(cpu: dict, with_model: bool = True) -> str:
    """
    One line: what it is, and how much of it there really is.

    Both counts, because "4 cpus" on a 2-core part overstates by half and the
    overstatement is what makes a slow run look inexplicable. The model name
    leads, because it is the thing that sets expectations — a 2.1GHz Pentium
    4405U is a 2015 low-power laptop part, and an agent estimating how long a
    build should take has no way to know that from a core count.

    `with_model=False` for the continuation line, which would otherwise repeat
    the name directly above it.
    """
    bits = []
    if with_model:
        if cpu.get("model"):
            bits.append(cpu["model"])
        elif cpu.get("arch"):
            bits.append(cpu["arch"])

    cores, logical = cpu.get("cores"), cpu.get("logical")
    if cores and logical and cores != logical:
        bits.append(f"{cores} cores / {logical} threads")
    elif logical:
        bits.append(f"{logical} {'core' if logical == 1 else 'cores'}")
    elif cores:
        bits.append(f"{cores} cores")
    if cpu.get("mhz"):
        bits.append(f"{cpu['mhz'] / 1000:.2f} GHz")
    if cpu.get("cache"):
        bits.append(f"cache {cpu['cache']}")
    return "   ".join(bits) or ("not readable" if with_model else "")


def _utf8_locale() -> bool:
    """
    Whether the locale can represent the characters in a session title.

    Not academic: titles here contain typographic apostrophes, and a C locale
    turns them into replacement characters in a transcript and a `?` in a
    heading. Cheap to check and it explains a class of ugly output on someone
    else's machine.
    """
    for name in ("LC_ALL", "LC_CTYPE", "LANG"):
        value = os.environ.get(name)
        if value:
            return "utf-8" in value.lower() or "utf8" in value.lower()
    return False


def _file_version(path: str) -> str:
    """
    A version read from a file, for the installations skew shows up in.

    Its own function because the whole point of the report is that these are
    three separate numbers from three separate files, and reading them inline
    meant the only way to test it was to compare them against the machine's own
    -- where they happen to agree. A helper takes a path, so a test can point
    it at a fixture that disagrees.
    """
    try:
        text = Path(path).read_text()
        if path.endswith(".json"):
            version = str(json.loads(text).get("version", ""))
        else:
            version = text.strip()
    except (OSError, ValueError):
        return "not readable"
    return version or "unknown"


def environment_stats(store: Store) -> dict:
    """
    The machine this OpenCode is running on, as far as it affects behaviour.

    Everything here is one of two things: a **version skew** between the several
    installations of OpenCode that coexist on one machine, or a **limit** the
    machine imposes that a bigger session would hit. Neither shows up in
    anything else in this report, and both are what "it works on my laptop"
    turns out to have been.

    Deliberately no `opencode --version` fork here. The version skew that
    matters is between the desktop app, the CLI it bundles, and the CLI on PATH,
    and the first two are readable from files. Forking mise to ask a shim takes
    over a second, and a report window that takes a second to appear is a worse
    trade than a version line that says "bundled".
    """
    env: dict = {
        "session_type": os.environ.get("XDG_SESSION_TYPE", "unset"),
        "wayland_display": os.environ.get("WAYLAND_DISPLAY", "unset"),
        "display": os.environ.get("DISPLAY", "unset"),
        "gdk_scale": os.environ.get("GDK_SCALE", "unset"),
        "gdk_dpi": os.environ.get("GDK_DPI_SCALE", "unset"),
        "locale_utf8": _utf8_locale(),
        "lang": os.environ.get("LANG") or os.environ.get("LC_ALL") or "unset",
        "cpus": os.cpu_count(),
        "cpu": _cpu_info(),
        "machine": _machine_info(),
        "load": os.getloadavg() if hasattr(os, "getloadavg") else (0, 0, 0),
    }

    # Which installations exist. `command -v` finds the shim, not the binary,
    # which is the point: a mise shim on PATH and the CLI bundled inside the
    # desktop app are two installations that happen to agree today.
    on_path = shutil.which("opencode")
    env["opencode_on_path"] = on_path or "not found"
    for label, path in (
        ("desktop app", "/usr/lib/opencode-desktop/package.json"),
        ("cli the desktop app bundles",
         "/usr/lib/opencode-desktop/opencode-cli.version"),
    ):
        env[label] = _file_version(path)

    # The scripts the plugins will actually run. A stale copy in ~/.local/bin
    # tests stale code and reports nothing wrong, which has happened in this
    # repo more than once.
    resolved = {}
    for name in ("session-list-popup", "info-window"):
        path = Path.home() / ".local" / "bin" / name
        try:
            resolved[name] = str(path.resolve())
        except OSError:
            resolved[name] = "not installed"
    env["scripts"] = resolved

    mem = _meminfo()
    if mem:
        env["mem_total"] = mem.get("MemTotal")
        env["mem_available"] = mem.get("MemAvailable")
        env["swap_total"] = mem.get("SwapTotal")
    try:
        st = os.statvfs(store.path.parent)
        env["disk_free_gb"] = st.f_bavail * st.f_frsize / 1073741824
        env["disk_total_gb"] = st.f_blocks * st.f_frsize / 1073741824
    except OSError:
        pass

    # Which schema is live decides which read path the popup took; a v1
    # `session` table is not a problem, it is just a different code path.
    env["schema"] = store.table
    return env


def _process_label(cmd: str) -> str:
    """What this process IS, from its command line, in words."""
    for needle, label in (
        ("opencode-cli serve", "background service"),
        ("session-list-popup", "session popup window"),
        ("--type=gpu-process", "desktop gpu process"),
        ("--type=renderer", "desktop renderer"),
        ("utility-sub-type=network", "desktop network helper"),
        ("utility-sub-type=audio", "desktop audio helper"),
        ("--type=zygote", "desktop zygote"),
        ("crashpad", "desktop crash handler"),
        ("--type=", "desktop helper"),
        ("electron", "desktop app"),
    ):
        if needle in cmd:
            return label
    return "other"


def running_processes() -> list[dict]:
    """
    OpenCode processes running right now, read from /proc.

    `/proc` rather than `ps` for three reasons: no fork, so asking the question
    cannot spawn the thing it is reporting on; no output format to parse, which
    differs between `ps` implementations and would make every column a string
    and a hope; and only the caller's own processes are considered, so there are
    no permission errors and nothing about another user on the machine leaks into
    a window that gets copied out of.

    `comm` may contain spaces and parentheses, so the fields after it are read
    by splitting on the LAST `)` rather than on whitespace. Getting that wrong
    shifts every column by one and produces a plausible, completely wrong RSS.
    """
    try:
        clock = os.sysconf("SC_CLK_TCK")
        page = os.sysconf("SC_PAGE_SIZE")
        uptime = float(Path("/proc/uptime").read_text().split()[0])
        uid = os.getuid()
    except (OSError, ValueError, AttributeError):
        return []

    out: list[dict] = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != uid:
                continue
            argv = (entry / "cmdline").read_bytes().split(b"\0")
            argv = [a.decode("utf8", "ignore") for a in argv if a]
            if not argv:
                continue
            # Match the PROGRAM, not anywhere in the line.
            #
            # Matching the whole command line finds every shell, editor, grep
            # and test runner that merely MENTIONS an opencode path. A shell
            # whose command line was `cd .../opencode-session-transcript && ...`
            # was reported as an OpenCode process, which is worse than useless.
            # The executable answers "what is this running", which is the
            # question actually being asked.
            try:
                exe = os.readlink(entry / "exe")
            except OSError:
                exe = argv[0]
            program = os.path.basename(exe)
            named = os.path.basename(argv[0])
            if not ("opencode" in program or "electron" in program
                    or "opencode" in named or "session-list-popup" in named):
                continue
            cmd = " ".join(argv)
            raw = (entry / "stat").read_text()
            fields = raw[raw.rindex(")") + 2:].split()
            ppid = int(fields[1])
            cpu = (int(fields[11]) + int(fields[12])) / clock
            rss = int(fields[21]) * page / 1048576
            started = uptime - int(fields[19]) / clock
        except (OSError, ValueError, IndexError):
            # A process can exit between the check and the read. That is the
            # normal case when scanning, not an error worth reporting.
            continue
        out.append({
            "pid": int(entry.name), "ppid": ppid, "rss_mb": rss,
            "cpu_s": cpu, "elapsed_s": started,
            "label": _process_label(cmd), "cmd": cmd,
        })
    return sorted(out, key=lambda p: -p["rss_mb"])


def session_sections(s: dict) -> list[tuple[str, object]]:
    """One session, as (heading, body) pairs -- the sections the window folds."""
    if not s:
        return [("", "No such session.")]
    tok = s["tokens"]
    cache = tok["cache_read"]
    read_ratio = (cache / (cache + tok["input"]) * 100) if (cache + tok["input"]) else 0.0
    activity = [
        f"  {s['tool_calls']:>12,}   tool calls"
        f"   {s['errors']:,} of them failed",
        f"  {s['compactions']:>12,}   context compactions",
        f"  {s['resume_attempts']:>12,}   resume attempts",
    ]
    if s.get("idle_outcome"):
        activity.append(f"  {'':>12}   last outcome: {s['idle_outcome']}")

    tail = [f"  {s['title']}", f"  {s['id']}"]
    if s.get("directory"):
        tail.append(f"  {s['directory']}")
    if s.get("archived"):
        tail.append(f"  archived {stamp(s['archived'])}")

    return [
        ("SIZE",
         f"  {_mb(s['bytes']):>12}   {s['messages']:,} messages"
         f"   {_dur(s['wall_ms'])} wall clock"),
        ("TIME",
         "\n".join([
             f"  {_dur(s['active_ms']):>12}   active, from gaps between messages"
             f" over {IDLE_GAP_MS // 60000}m",
             f"  {_dur(s['wall_ms'] - s['active_ms']):>12}   away from it",
         ])),
        ("COST AND TOKENS", "\n".join([
            f"  ${s['cost']:>11.4f}   what this session has cost so far",
            f"  {tok['input']:>12,}   input",
            f"  {tok['output']:>12,}   output",
            f"  {tok['reasoning']:>12,}   reasoning",
            f"  {cache:>12,}   read from cache"
            f"  ({read_ratio:.1f}% of everything sent)",
            f"  {tok['cache_write']:>12,}   written to cache",
        ])),
        ("ACTIVITY", "\n".join(activity)),
        ("MESSAGES BY KIND", "\n".join(
            f"  {kind:<12} {count:,}" for kind, count in
            sorted(s["kinds"].items(), key=lambda kv: -kv[1]))),
        ("TOOLS (calls)", "\n".join(_counter_rows(s["tools"]))),
        ("FILES TOUCHED", group_by_directory(s["files"])),
        ("MODELS (messages)", "\n".join(_counter_rows(s["models"]))),
        ("PROVIDERS (messages)", "\n".join(_counter_rows(s.get("providers", {})))),
        ("SESSION", "\n".join(tail)),
    ]


def _environment_lines(env: dict) -> list[str]:
    """The machine, as the lines the report shows."""
    lines = []
    machine = env.get("machine") or {}
    if machine.get("vendor") or machine.get("model"):
        detail = machine.get("vendor", "")
        if machine.get("model"):
            detail = f"{detail} {machine['model']}".strip()
        lines.append(f"  {'machine':<22} {detail}")
        extra = "   ".join(
            part for part in (
                machine.get("chassis"),
                f"type {machine['type']}" if machine.get("type") else "",
                f"bios {machine['bios']}" if machine.get("bios") else "",
            ) if part)
        if extra:
            lines.append(f"  {'':<22} {extra}")
        lines.append("")

    lines += [
        f"  {'display':<22} {env['session_type']}"
        f"   WAYLAND_DISPLAY={env['wayland_display']}"
        f"   DISPLAY={env['display']}",
        f"  {'gtk scale':<22} GDK_SCALE={env['gdk_scale']}"
        f"   GDK_DPI_SCALE={env['gdk_dpi']}",
        f"  {'locale':<22} {env['lang']}"
        f"   {'utf-8' if env['locale_utf8'] else 'NOT utf-8, titles show ?'}",
        "",
        f"  {'desktop app':<22} {env['desktop app']}",
        f"  {'cli it bundles':<22} {env['cli the desktop app bundles']}",
        f"  {'opencode on PATH':<22} {env['opencode_on_path']}",
        f"  {'database schema':<22} {env['schema']}",
        "",
        f"  {'load':<22} {env['load'][0]:.1f} {env['load'][1]:.1f} {env['load'][2]:.1f}",
    ]
    cpu = env.get("cpu") or {}
    if cpu.get("model") or cpu.get("cores") or cpu.get("logical"):
        lines.append(f"  {'cpu':<22} {cpu.get('model') or cpu.get('arch') or 'unknown'}")
        lines.append(f"  {'':<22} {_cpu_summary(cpu, with_model=False)}")
    else:
        lines.append(f"  {'cpu':<22} not readable")
    if env.get("mem_total"):
        lines.append(
            f"  {'memory':<22} {env['mem_total']:,} MB total"
            f"   {env['mem_available']:,} MB available"
            f"   swap {env.get('swap_total', 0):,} MB")
    if env.get("disk_free_gb"):
        lines.append(
            f"  {'disk holding the db':<22} {env['disk_free_gb']:,.0f} GB free"
            f" of {env['disk_total_gb']:,.0f} GB")
    lines += ["", "  scripts the plugins will run:"]
    for name, path in env["scripts"].items():
        # In full, not `_short`. The whole point of this line is to answer "is
        # the binary I'm running the one in this repo, or a stale copy in
        # ~/.local/bin" -- and `_short` keeps the tail, so it ate
        # `/home/steven/Documents/` and left `…ct/opencode-session-transcript`,
        # which names the repo but not where it is and not which install won.
        # The same truncation was already removed from FILES TOUCHED for the
        # same reason: a truncated path that cannot be told from another
        # truncated path is worse than a long one.
        lines.append(f"    {name:<20} {path}")

    # USB, because slow I/O looks exactly like a hung agent. A drive on a 480
    # Mbps port is a dozen times slower than the same drive on a 5Gbps port,
    # and nothing in the session report can tell them apart.
    ports = usb_links()
    if ports:
        lines += ["", "  usb ports, at the speed they actually negotiated:"]
        for port in ports:
            where = ""
            if port.get("mount"):
                where = f"  →  {port['block']} at {port['mount']}"
            elif port.get("block"):
                where = f"  →  {port['block']}"
            lines.append(
                f"    {port['port']:<6} {port['mbps']:>6,} Mbps"
                f"  {port['kind']:<24} {port['product']}{where}")
    return lines


def database_sections(d: dict, store: "Store | None" = None) -> list[tuple[str, object]]:
    """
    The whole store, as (heading, body) pairs.

    `store` is optional so an empty report still renders -- the tests pass `{}`
    and must get "No sessions found." rather than a crash on the environment
    probe, which needs a real path to ask about disk.
    """
    if not d:
        return [("", "No sessions found.")]
    tok = d["tokens"]
    biggest = sorted(d["sizes"].items(), key=lambda kv: -kv[1][1])[:12]
    created = d["created_range"]

    size_lines = [
        f"  {_mb(d['on_disk']):>12}   the database, including its write-ahead log",
        f"  {_mb(d['message_bytes']):>12}   of which is session messages",
        f"  {_mb(d['backups_bytes']):>12}   snapshots kept"
        f" ({d['backups_count']}), which archiving does not touch",
    ]
    # Live processes belong here and not on a session row: they are a property
    # of the machine, not of any one conversation. Useful on its own -- the
    # background service outlives the desktop window that spawned it -- and it
    # is the one figure in this report that is not about the database at all.
    procs = running_processes()
    proc_lines = [
        f"  {len(procs):>3} processes, {sum(p['rss_mb'] for p in procs):,.0f} MB"
        f" resident in total",
        "",
        f"  {'pid':>7} {'ppid':>7} {'rss MB':>8} {'cpu s':>8} {'up':>9}  what",
    ]
    for p in procs:
        proc_lines.append(
            f"  {p['pid']:>7,} {p['ppid']:>7,} {p['rss_mb']:>8,.0f}"
            f" {p['cpu_s']:>8,.0f} {_dur(p['elapsed_s'] * 1000):>9}  {p['label']}")

    # The machine. Not decoration: everything here is a version skew between the
    # several OpenCode installations one machine tends to accumulate, or a limit
    # that a bigger session would hit. Neither is visible anywhere else in this
    # report, and both are what "it only misbehaves on my laptop" is made of.
    env = environment_stats(store) if store is not None else {}
    if env:
        env_lines = _environment_lines(env)
    else:
        env_lines = ["  (no store available to describe the machine)"]
    largest = [f"  {_mb(size):>10}  {title}" for _sid, (title, size) in biggest]
    span = []
    if created[0]:
        span = [f"  first session {stamp(created[0])}",
                f"  newest       {stamp(created[1])}"]

    return [
        ("ON DISK", "\n".join(size_lines)),
        ("ENVIRONMENT", "\n".join(env_lines)),
        ("RUNNING PROCESSES", "\n".join(proc_lines)),
        ("CONTENTS", "\n".join([
            f"  {d['sessions']:>12,}   sessions, {d['archived']:,} archived",
            f"  {d['messages']:>12,}   messages",
        ])),
        ("COST AND TOKENS, ALL SESSIONS", "\n".join([
            f"  ${d['cost']:>11.4f}   in total",
            f"  {tok['input']:>12,}   input",
            f"  {tok['output']:>12,}   output",
            f"  {tok['reasoning']:>12,}   reasoning",
            f"  {tok['cache_read']:>12,}   read from cache",
        ])),
        ("LARGEST SESSIONS", "\n".join(largest)),
        ("TOOLS, ALL SESSIONS (calls)", "\n".join(_counter_rows(d["tools"], 14))),
        ("MOST TOUCHED FILES", group_by_directory(d["files"])),
        ("MODELS (messages)", "\n".join(_counter_rows(d["models"]))),
        ("PROVIDERS (messages)", "\n".join(_counter_rows(d.get("providers", {})))),
        ("MESSAGES BY KIND", "\n".join(
            f"  {kind:<12} {count:,}" for kind, count in
            sorted(d["kinds"].items(), key=lambda kv: -kv[1]))),
        ("SPAN", "\n".join(span)),
    ]


# A section longer than this starts folded. The point of the report is a feel
# for what happened, and a scrollbar full of file paths hides the three numbers
# that give it. Anything short enough to read at a glance stays open.
FOLD_AFTER_LINES = 12


def _as_text(content) -> str:
    """
    Flatten section content to text, whatever shape it arrived in.

    Two callers need the same answer: the fold decision, which wants a line
    count, and Copy, which wants the whole report. A file section is a list of
    groups rather than a string, and calling `.splitlines()` on it would either
    crash or quietly count the groups instead of the rows.
    """
    if isinstance(content, str):
        return content
    return "\n".join(f"{label}\n" + "\n".join(rows) for label, rows in content)


def report_text(sections: list[tuple[str, object]]) -> str:
    """Every section as plain text -- what Copy puts on the clipboard."""
    return "\n\n".join(
        f"{heading}\n{_as_text(content)}" if heading else _as_text(content)
        for heading, content in sections)


def format_session_report(s: dict) -> str:
    """One session, as the lines the window shows."""
    return report_text(session_sections(s))


def format_database_report(d: dict) -> str:
    """The whole store, as the lines the window shows."""
    return report_text(database_sections(d))


class Window(Gtk.Window):
    def __init__(self, store: Store):
        super().__init__(title="OpenCode sessions")
        # Set WM_CLASS so Hyprland can match it with window rules
        self.set_wmclass("session-list-popup", "session-list-popup")
        # Use DIALOG hint so Wayland compositors (Hyprland) center it
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.store = store
        self.set_default_size(900, 620)
        self.font_size = load_font_size()
        self.rows: list[dict] = []
        # The two view controls, kept as state rather than read back off their
        # widgets. reload() runs after every write, and a sort or a search that
        # reset itself each time would be worse than not having them.
        self.sort_mode = DEFAULT_SORT  # a mode from SORTS
        self.query = ""

        # Size to the screen rather than a fixed guess. The window is floated
        # and centred by a Hyprland rule in ~/.config/hypr/looknfeel.lua, so
        # this only has to ask for a sensible size and stay inside the screen.
        #
        # Clamped, because a fixed 1100x760 request on a 1366x768 panel with
        # decorations is wider than the usable area and gets clipped.
        screen = Gdk.Screen.get_default()
        if screen is not None:
            sw, sh = screen.get_width(), screen.get_height()
            self.set_size_request(
                min(400, sw - 60),
                min(320, sh - 100),
            )
            self.set_default_size(
                min(1100, int(sw * 0.80)),
                min(720, int(sh * 0.80)),
            )

        # One provider, kept and reloaded, rather than a new one per click.
        # add_provider_for_screen stacks providers, so replacing it each time
        # would leave the old ones behind and the size would only ever climb.
        self._css = Gtk.CssProvider()
        self._css.load_from_data(scaled_css(CSS, self.font_size))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), self._css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        # ---- header
        banner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)

        banner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        banner.get_style_context().add_class("banner")
        t = Gtk.Label(label="OpenCode sessions")
        t.get_style_context().add_class("banner-title")
        t.set_xalign(0)
        h = Gtk.Label(
            label="Click a session for its buttons: Stats, Archive or "
            "Restore, Transcript.md, Export.json, Delete, Close.\n\n"
            "Stats is read-only and reports one session. Database, in the "
            "footer, reports the whole store and this machine.\n\n"
            "Rows light up under the mouse. The three buttons pick the order;\n"
            "the box filters as you type.\n\n"
            "OpenCode's own session menu caches its list, so restart it after "
            "archiving, restoring or deleting here."
        )
        # Wrapped, and capped, so the banner's natural width cannot set the
        # window's. It did: an unwrapped Gtk.Label asks for its longest line,
        # which overrode the 1100px default and opened the window wider than
        # the screen. `set_default_size` is only a default -- any child
        # requesting more wins -- so the fix belongs on the label.
        self.banner_label = h
        _cols = banner_cols(self.font_size)
        h.set_line_wrap(True)
        h.set_width_chars(_cols)
        h.set_max_width_chars(_cols)
        h.get_style_context().add_class("banner-hint")
        h.set_xalign(0)
        banner.pack_start(t, False, False, 0)
        banner.pack_start(h, False, False, 0)
        # The banner scrolls inside a bounded box rather than setting the
        # window's height. Capping the width was not enough: at a large font the
        # wrapped paragraphs wrap into enough lines to push the window to 783px
        # on a 768px screen.
        #
        # `set_propagate_natural_height(False)` and `set_size_request` are
        # **insurance, not the fix** -- the mutation runs removed each of them
        # on its own and the window still fit at every size, because the
        # ScrolledWindow is what does the work. Kept because a different theme
        # or GTK build may measure the wrapped label differently, and because
        # the intent ("the banner is never taller than this") is worth stating
        # where the height is set. Worth knowing before anyone "simplifies" one
        # away assuming the other covers it -- neither demonstrably does.
        banner_box = Gtk.ScrolledWindow()
        banner_box.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        banner_box.set_propagate_natural_width(False)
        banner_box.set_propagate_natural_height(False)
        banner_box.set_size_request(-1, BANNER_MAX_H)
        banner_box.add(banner)
        root.pack_start(banner_box, False, False, 0)

        # ---- toolbar: sort toggle and search
        #
        # Above the list, not in the footer with Close. The footer is where the
        # counts are, and a control that changes those counts belongs beside the
        # thing it changes -- reading "3 of 16 shown" and having the reason
        # three widgets away is the same problem as a status bar whose filter
        # lives in a menu.
        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        toolbar.get_style_context().add_class("toolbar")

        self.sort_buttons: list[Gtk.RadioButton] = []
        previous: Gtk.RadioButton | None = None
        for mode, label, _field, description in SORTS:
            # `new_with_label_from_widget` is the only way to make one of these
            # in PyGObject: without a previous button each one becomes its own
            # group, and all three would read as selected at once.
            btn = (
                Gtk.RadioButton.new_with_label_from_widget(previous, label)
                if previous is not None
                else Gtk.RadioButton.new_with_label_from_widget(None, label)
            )
            btn.set_tooltip_text(
                f"Sort {description}.\n\n"
                f"The order resets to {DEFAULT_SORT_LABEL} each time the "
                f"window is opened."
            )
            btn.set_active(mode == self.sort_mode)
            btn.connect("toggled", self._on_sort_toggled, mode)
            self.sort_buttons.append(btn)
            toolbar.pack_start(btn, False, False, 0)
            previous = btn

        # A SearchEntry rather than an Entry: it gets the magnifier and the
        # clear-the-box affordance for free, which is the whole of the
        # interaction otherwise.
        self.search = Gtk.SearchEntry()
        self.search.set_hexpand(True)
        self.search.set_placeholder_text(
            "Find sessions by title, id or folder…"
        )
        self.search.set_tooltip_text(
            "Type to narrow the list. Words are combined, so two words must both "
            "appear -- in the title, the id, or the folder.\n\n"
            "Esc while this box is focused clears it."
        )
        self.search.connect("search-changed", self._on_search_changed)
        toolbar.pack_start(self.search, True, True, 0)

        root.pack_start(toolbar, False, False, 0)

        # ---- scrolling list
        scroller = Gtk.ScrolledWindow()
        # AUTOMATIC horizontally, not NEVER. NEVER means content wider than
        # the window is clipped silently, which is how buttons disappeared on a
        # narrow tile. With AUTOMATIC the row scrolls instead, so an action is
        # always reachable however little width there is.
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        # Stop the list sizing the window. A ScrolledWindow propagates its
        # child's natural width upwards by default, so a long row can ask the
        # window to be wider than the screen.
        #
        # This does not change the scroll policy above: a row wider than the
        # window still scrolls, it just no longer decides how wide the window
        # is. That distinction is the whole point of the two calls.
        scroller.set_propagate_natural_width(False)
        scroller.set_propagate_natural_height(False)
        self.listbox = Gtk.ListBox()
        # SINGLE, not NONE: right-click has to leave a visible selection, or
        # there is no confirmation of which session an action would hit.
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-selected", self._on_row_selected)
        scroller.add(self.listbox)
        root.pack_start(scroller, True, True, 0)

        # ---- footer
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.get_style_context().add_class("hintbar")
        self.status = Gtk.Label(label="")
        self.status.get_style_context().add_class("hintbar-label")
        self.status.set_xalign(0)
        self.status.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        footer.pack_start(self.status, True, True, 0)

        # No Refresh button. The window refreshes itself after every write it
        # makes -- archive, restore, delete -- and re-reads the database on
        # launch, so its own list cannot go stale while you are looking at it. A
        # manual refresh would be a third path to the same thing and one more
        # thing to forget to press.
        #
        # Named "Close window", not "Close": each row's strip now has its own
        # Close that does nothing but back out of that strip, and two buttons
        # with the same name on screen at once is a trap.
        # Database, once per window rather than once per row: see _show_database_stats.
        db_btn = Gtk.Button(label="Database")
        db_btn.set_tooltip_text(
            "Open a read-only report for the whole database in its own window: "
            "how much space it takes, how many sessions and messages, total "
            "cost, and which sessions are largest.\n\n"
            "Useful when deciding what to archive, since size is the figure that "
            "changes what to do next. Nothing on it writes."
        )
        db_btn.connect("clicked", lambda *_: self._show_database_stats())
        footer.pack_end(db_btn, False, False, 0)

        # Architecture diagram — how OpenCode works on this machine.
        arch_btn = Gtk.Button(label="Architecture")
        arch_btn.set_tooltip_text(
            "Open a window showing how OpenCode fits together on this laptop: "
            "Hyprland, the desktop app, the Rust server, the plugin host, the "
            "Python GTK windows, the SQLite database, and the LLM provider."
        )
        arch_btn.connect("clicked", lambda *_: self._show_architecture())
        footer.pack_end(arch_btn, False, False, 0)

        # A-, A+ and Reset, matching opencode-popup-window's info-window so the
        # two behave the same way in the same place. Packed between Database and
        # Close rather than at either end: they adjust what you are reading, so
        # they belong next to the content, and Close stays last because it is
        # the only irreversible-looking thing there.
        smaller = Gtk.Button(label="A-")
        smaller.set_tooltip_text(
            f"Smaller text. Also Ctrl+minus. Smallest is {FONT_MIN}px.")
        smaller.connect("clicked", lambda *_: self.set_font_size(self.font_size - FONT_STEP))
        footer.pack_end(smaller, False, False, 0)

        bigger = Gtk.Button(label="A+")
        bigger.set_tooltip_text(
            f"Bigger text. Also Ctrl+plus. Largest is {FONT_MAX}px.")
        bigger.connect("clicked", lambda *_: self.set_font_size(self.font_size + FONT_STEP))
        footer.pack_end(bigger, False, False, 0)

        reset_size = Gtk.Button(label="Reset size")
        reset_size.set_tooltip_text(
            f"Back to the default {FONT_DEFAULT}px. Also Ctrl+0.")
        reset_size.connect("clicked", lambda *_: self.set_font_size(FONT_DEFAULT))
        footer.pack_end(reset_size, False, False, 0)

        close = Gtk.Button(label="Close window")
        close.connect("clicked", lambda *_: self.destroy())
        footer.pack_end(close, False, False, 0)
        root.pack_start(footer, False, False, 0)

        self.connect("key-press-event", self.on_key)

        # Focus-in is connected but deliberately does nothing -- see
        # _on_focus_in for why it stopped reloading. It is left wired because
        # that is the natural place to reintroduce a refresh if one is ever
        # wanted again.
        self.connect("focus-in-event", self._on_focus_in)
        self.reload()

    # ------------------------------------------------------------- rendering

    def reload(self) -> None:
        """
        Rebuild the list: grouped by state, filtered by the search box, sorted
        by whichever mode the sort button is in.

        The filter and the sort are read off `self` rather than passed in, so
        they survive every reload -- which happens after each archive, restore
        and delete. Passing them as arguments would mean a write threw away a
        search you had just typed, and the row you acted on would be the only
        one still on screen.

        Name is no longer the default. It was, until the flip to newest-first,
        and this paragraph kept asserting it long afterwards. An alphabetical
        list is what "find the session called X" scans, which is true, and is
        also why Name stayed on as a button rather than as the default. The
        default is DEFAULT_SORT, and it is read off `self` rather than
        restated here so it cannot go stale again.

        Within Name, `time_updated` is deliberately not a tiebreaker: the store
        returns most-recent-first, so adding it would reproduce recency
        ordering for every pair of same-titled sessions, which is not a tie
        anyone asked to be broken.
        """
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        data = self.store.list()
        order = next(o for o in SORTS if o[0] == self.sort_mode)
        sort = by_name if order[2] is None else lambda r: by_date(r, order[2])

        # Filtering happens against the whole set, before the split, so the
        # status line can say how much is hidden as well as what is shown --
        # `len(shown) != len(data)` below is what "3 of 16" is built from.
        shown = filter_rows(data, self.query)
        working = sort([d for d in shown if not d["archived"]])
        archived = sort([d for d in shown if d["archived"]])
        self.rows = []

        if not data:
            lbl = Gtk.Label(label="No sessions found.")
            lbl.set_margin_top(24)
            self.listbox.add(lbl)
            self.status.set_text("Nothing in the database.")
            self.show_all()
            return

        if not shown:
            # Its own message, not an empty list. A blank area under a search
            # box reads as a broken window; saying what was searched for tells
            # you whether the term was wrong or the sessions are not here.
            #
            # Wrapped in an explicit ListBoxRow and marked as a section, because
            # a bare widget added to a ListBox is wrapped in a row of its own
            # -- and an unmarked row is a session as far as everything
            # downstream is concerned. It would be counted in the totals, and
            # right-clicking it would open a strip with no session behind it.
            # See _section().
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.set_margin_top(24)
            none = Gtk.Label(label=f"No sessions match “{self.query.strip()}”.")
            none.get_style_context().add_class("section")
            none.set_xalign(0)
            box.add(none)
            clear = Gtk.Label(label=f"Clear the box to see all {len(data)}.")
            clear.get_style_context().add_class("meta")
            clear.set_xalign(0)
            box.add(clear)
            row = Gtk.ListBoxRow()
            row.is_section = True
            row.session_id = None
            row.set_selectable(False)
            row.add(box)
            self.listbox.add(row)
            self.status.set_text(
                f"0 of {len(data)} shown  ·  filter: “{self.query.strip()}”  ·  "
                f"the filter covers title, id and folder"
            )
            self.show_all()
            return

        if working:
            self.listbox.add(
                self._section("UNARCHIVED — click one to Archive it")
            )
            for d in working:
                self.listbox.add(self._row(d, archived=False))
        if archived:
            self.listbox.add(
                self._section("ARCHIVED — click one to Restore it")
            )
            for d in archived:
                self.listbox.add(self._row(d, archived=True))

        live = sum(1 for d in working if d.get("is_live"))
        parts = [f"{len(working)} working", f"{len(archived)} archived"]
        if len(shown) != len(data):
            parts.insert(0, f"{len(shown)} of {len(data)} shown")
            parts.append(f"filter: “{self.query.strip()}”")
        parts.append(order[3])
        parts.append("click a row for its buttons, Close to back out")
        hint = "  ·  ".join(parts)
        if live:
            hint += "  ·  the THIS SESSION row cannot be archived or deleted"
        self.status.set_text(hint)
        # show_all() is safe now: every strip carries set_no_show_all(True), so
        # this reveals rows and buttons without revealing the hidden strips.
        self.show_all()

    def _section(self, text: str) -> Gtk.Widget:
        # Gtk.ListBox wraps a bare label in a row of its own, so a heading is
        # still a ListBoxRow and would otherwise be picked up as a session.
        # `is_section` is what tells the two apart everywhere downstream.
        row = Gtk.ListBoxRow()
        row.is_section = True
        row.session_id = None
        lbl = Gtk.Label(label=text)
        lbl.get_style_context().add_class("section")
        lbl.set_xalign(0)
        lbl.set_margin_top(10)
        row.add(lbl)
        row.set_selectable(False)
        return row

    def _row(self, d: dict, archived: bool) -> Gtk.Widget:
        row = Gtk.ListBoxRow()
        row.get_style_context().add_class("row")
        row.session_id = d["id"]
        row.set_selectable(False)  # Only switch triggers selection

        # Switch as row selector - clicking it shows the action strip
        switch = Gtk.Switch()
        switch.set_halign(Gtk.Align.START)
        switch.set_valign(Gtk.Align.CENTER)
        switch.set_margin_start(8)
        switch.set_margin_end(8)
        switch.set_can_focus(False)
        switch.set_active(False)
        switch.get_style_context().add_class("session-switch")
        switch.connect("notify::active", self._on_switch_changed, row)

        # A GtkListBoxRow is a GtkBin: exactly one child. The row content and
        # the action strip therefore share a single vertical wrapper, which is
        # why adding the strip directly to the row would be silently refused.
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        row.add(outer)

        # Switch + content in a horizontal box
        content_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        outer.pack_start(content_box, False, False, 0)

        # Switch on the left
        content_box.pack_start(switch, False, False, 0)

        # Content on the right (fills remaining space)
        content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        content.set_margin_top(5)
        content.set_margin_bottom(5)
        content.set_margin_start(14)
        content.set_margin_end(14)
        content_box.pack_start(content, True, True, 0)

        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        texts.set_valign(Gtk.Align.CENTER)

        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = Gtk.Label(label=d["title"] or "(untitled)")
        title.get_style_context().add_class("title")
        title.set_xalign(0)
        title.set_ellipsize(3)
        title.set_hexpand(True)
        title.set_max_width_chars(60)
        title_box.pack_start(title, True, True, 0)
        if archived:
            chip = Gtk.Label(label="ARCHIVED")
            chip.get_style_context().add_class("chip")
            chip.set_valign(Gtk.Align.CENTER)
            title_box.pack_start(chip, False, False, 0)
        elif d.get("is_live"):
            chip = Gtk.Label(label="THIS SESSION")
            chip.get_style_context().add_class("chip-live")
            chip.set_valign(Gtk.Align.CENTER)
            chip.set_tooltip_text(
                "The session currently open in OpenCode. It cannot be archived "
                "from here, so you cannot archive the conversation you are in."
            )
            title_box.pack_start(chip, False, False, 0)
        texts.pack_start(title_box, False, False, 0)

        msgs = d["messages"] if d["messages"] is not None else "?"
        bits = [f"{msgs} msg", stamp(d["time_updated"])]
        if d["directory"]:
            bits.append(short_dir(d["directory"]))
        meta = Gtk.Label(label="  ·  ".join(bits))
        meta.get_style_context().add_class("meta")
        meta.set_xalign(0)
        texts.pack_start(meta, False, False, 0)

        ident = Gtk.Label(label=d["id"])
        ident.get_style_context().add_class("id")
        ident.set_xalign(0)
        texts.pack_start(ident, False, False, 0)

        content.pack_start(texts, True, True, 0)

        # The action strip sits inside the same row, directly beneath the title
        strip = self._action_strip(d, archived)
        strip.set_no_show_all(True)
        strip.hide()
        outer.pack_start(strip, False, False, 0)
        row.actions = strip
        row.switch = switch

        # No button-press handler needed - switch handles selection
        return row

    def _action_strip(self, d: dict, archived: bool) -> Gtk.Widget:
        """
        The Archive/Restore choice, inline under the row.

        Built per row so it closes over the session's own id.

        For the live session the strip states plainly that archiving is not
        allowed, and the button is disabled rather than removed: a missing
        button reads as a bug, whereas a disabled one with a reason reads as a
        rule. The write path refuses it too, so the disabled state is not the
        only thing standing between a click and an archived conversation.
        """
        strip = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        strip.get_style_context().add_class("actions")
        strip.set_margin_start(54)
        strip.set_margin_end(14)
        strip.set_margin_bottom(6)

        # A FlowBox wraps its children onto a new line when they no longer fit.
        # That is what keeps Archive/Restore reachable on a half-width tile
        # instead of clipped past the right edge, which a fixed horizontal box
        # cannot do -- it either overflows or steals width from its label.
        # Three per line: six buttons wrap as 3+3 rather than 4+2.
        buttons = Gtk.FlowBox()
        buttons.set_selection_mode(Gtk.SelectionMode.NONE)
        buttons.set_max_children_per_line(3)
        buttons.set_row_spacing(4)
        buttons.set_column_spacing(6)
        # FILL, the default, and left-aligned children.
        #
        # The strip used to set halign END on this box, which is what put the
        # buttons down the right-hand side -- and with only three buttons that
        # was harmless. `halign` on a FlowBox means "do not expand me, give me
        # my natural width", and a FlowBox asked for its natural width in a
        # container that has not been allocated yet computes a single column.
        # Six buttons then stack one per line and the last one falls off the
        # bottom of the strip, out of sight.
        #
        # Aligning the children to the right instead -- the property that would
        # actually express the intent -- is not available: `child-alignment` is
        # absent from this PyGObject binding's property list, and setting it
        # raises AttributeError rather than being ignored. So the buttons sit
        # left, under the label, which is also where the eye starts.

        if archived:
            label = Gtk.Label(label="Restore this session")
        elif d.get("is_live"):
            label = Gtk.Label(
                label="This is the session you are working in - "
                "archiving it is not allowed from here"
            )
        else:
            label = Gtk.Label(label="Archive this session")
        label.get_style_context().add_class("actions-label")
        label.set_xalign(0)
        label.set_ellipsize(3)  # END
        strip.pack_start(label, False, False, 0)

        # The primary action leads: it is the one the section heading promised,
        # and it is inserted first so it sits at the start of the top line.
        #
        # Everything below it is the same on both an archived and an unarchived
        # row, so it is built once here rather than duplicated per branch. The
        # branches used to carry their own copies of the same four buttons,
        # which is how "Save .md" came to say ~/Documents in one branch and
        # nothing at all in the other.
        if archived:
            btn = Gtk.Button(label="Restore")
            btn.get_style_context().add_class("btn-restore")
            btn.set_tooltip_text(
                "Clear the archived flag and refresh time_updated, which is "
                "what makes the session reachable in OpenCode at all.\n\n"
                "You will still need to restart OpenCode before it appears in "
                "the app's own session menu -- that list is cached and this "
                "window cannot refresh it."
            )
            btn.connect("clicked", lambda *_: self._act(d["id"], archive=False))
        else:
            btn = Gtk.Button(label="Archive")
            btn.get_style_context().add_class("btn-archive")
            if d.get("is_live"):
                btn.set_sensitive(False)
                btn.get_style_context().add_class("btn-blocked")
                btn.set_tooltip_text(
                    "This is the session currently open in OpenCode. Archiving it "
                    "is not allowed from here, because you are working in it."
                )
            else:
                btn.set_tooltip_text(
                    "Set time_archived. OpenCode's own UI cannot undo this; "
                    "this window can."
                )
                btn.connect("clicked", lambda *_: self._act(d["id"], archive=True))
        buttons.insert(btn, -1)

        stats_btn = Gtk.Button(label="Stats")
        stats_btn.set_tooltip_text(
            "Open a read-only report for this session in its own window: how "
            "big it is, how long you actually spent on it, what it cost, which "
            "tools it used and which files it touched.\n\n"
            "Nothing on that window writes to the database."
        )
        stats_btn.connect("clicked", lambda *_: self._show_stats(d))
        buttons.insert(stats_btn, -1)

        read_btn = Gtk.Button(label="Transcript.md")
        read_btn.set_tooltip_text(
            "Write the whole transcript as Markdown to "
            "~/Downloads/<title>.md, and say where it went.\n\n"
            "For reading and searching. Two sessions with the same title write "
            "the same file, so the second replaces the first -- the window says "
            "so when it happens instead of clobbering quietly."
        )
        read_btn.connect("clicked", lambda *_: self._save_transcript(d))
        buttons.insert(read_btn, -1)

        export_btn = Gtk.Button(label="Export.json")
        export_btn.set_tooltip_text(
            "Write OpenCode's own export format to ~/Downloads/<title>.json, "
            "which `opencode session import` reads back.\n\n"
            "The only route off this machine. Archive and restore are writes to "
            "this database and do not exist anywhere else, so a session that "
            "must outlive this install needs this button."
        )
        export_btn.connect("clicked", lambda *_: self._export_json(d))
        buttons.insert(export_btn, -1)

        delete_btn = Gtk.Button(label="Delete")
        delete_btn.get_style_context().add_class("btn-delete")
        if d.get("is_live"):
            # Same rule as archiving: the conversation you are standing in is
            # not yours to remove from here.
            delete_btn.set_sensitive(False)
            delete_btn.get_style_context().add_class("btn-blocked")
            delete_btn.set_tooltip_text(
                "This is the session currently open in OpenCode. Deleting it is "
                "not allowed from here, because you are working in it."
            )
        else:
            delete_btn.set_tooltip_text(
                "Remove the session and its messages from the database, after "
                "asking you to confirm.\n\n"
                "A backup is taken first, but only the last three are kept, so "
                "this is close to irreversible. Export.json first if you are "
                "not sure."
            )
            delete_btn.connect("clicked", lambda *_: self._delete_session(d))
        buttons.insert(delete_btn, -1)

        close_btn = Gtk.Button(label="Close")
        close_btn.get_style_context().add_class("btn-quiet")
        close_btn.set_tooltip_text(
            "Close this strip and do nothing. Same as Escape, or clicking the "
            "row again -- but it is here rather than only in a keybinding."
        )
        close_btn.connect("clicked", lambda *_: self._dismiss())
        buttons.insert(close_btn, -1)

        strip.pack_start(buttons, False, False, 0)
        return strip

    def _dismiss(self) -> None:
        """
        Close whichever strip is open, without acting on anything.

        Opening a strip costs one right-click and the only ways out were Escape
        or a second click on the same row, neither of which is offered by the
        strip itself. So the strip carries its own exit, and this is where all
        three routes land: the button, Escape, and the switch on re-click.

        unselect_all() alone is not enough. It does not reliably emit
        row-selected with None, so the strip is hidden here as well rather than
        waiting for a signal that may never arrive.
        """
        self.listbox.unselect_all()
        for r in self.listbox.get_children():
            strip = getattr(r, "actions", None)
            if strip is not None:
                strip.hide()
            switch = getattr(r, "switch", None)
            if switch is not None:
                switch.set_active(False)

    def _on_press(self, widget, event) -> bool:
        """
        Only switch clicks should toggle the strip.
        Clicks on the session row itself do nothing.
        """
        row = self._row_of(widget)
        if row is None or getattr(row, "is_section", False):
            return False

        # Right-click on row still selects (for context menu if needed)
        if event.button == 3:
            self.listbox.select_row(row)
            self.listbox.emit("row-selected", row)
            return True

        # Left-click on row does nothing - only radio button clicks work
        return False

    def _on_switch_changed(self, switch, _pspec, row) -> None:
        """Switch changed -> select the row (shows its strip)."""
        if switch.get_active():
            # Switch turned ON -> show strip
            self.listbox.select_row(row)
            self.listbox.emit("row-selected", row)
        else:
            # Switch turned OFF -> hide strip
            if row.actions and not getattr(self, "_switch_setting", False):
                row.actions.hide()

    def _row_of(self, widget):
        while widget is not None and not isinstance(widget, Gtk.ListBoxRow):
            widget = widget.get_parent()
        return widget

    def _on_row_selected(self, _listbox, row) -> None:
        """
        Show exactly one strip — the selected row's.

        `show_all()` alone is not enough: the strip carries
        set_no_show_all(True) so that the window's own show_all() cannot reveal
        it, and that flag also suppresses this call. So the flag is lifted for
        the reveal and re-applied afterwards, otherwise the strip would stay
        hidden for the rest of the window's life once shown.
        """
        if row is None:
            return
        for r in self.listbox.get_children():
            strip = getattr(r, "actions", None)
            if strip is None:
                continue
            if r is row:
                strip.set_no_show_all(False)
                strip.show_all()
                strip.set_no_show_all(True)
            else:
                strip.hide()
                # Turn off switch for other rows
                switch = getattr(r, "switch", None)
                if switch is not None:
                    switch.set_active(False)

    # ------------------------------------------------------------- behaviour

    def _act(self, session_id: str, archive: bool) -> None:
        """Do the write, then rebuild so the grouping is never stale."""
        verb = "Archiving" if archive else "Restoring"
        try:
            res = self.store.set_archived([session_id], archive)
        except sqlite3.Error as err:
            self._toast(f"{verb} failed: {err}", error=True)
            return

        if res["changed"]:
            # Re-read from the database rather than patching the rows in place.
            # The session just moved between sections, so the list is rebuilt
            # from what was actually written and the write is announced.
            self.reload()
            backup = res["backup"].name if res["backup"] else "none"
            self.status.set_text(
                f"{'Archived' if archive else 'Restored'}: "
                f"{data_title(session_id, self.store)}  ·  backup {backup}"
            )
            self._toast(
                "Palette is stale — restart OpenCode (opencode reload) to sync",
                error=False
            )
        else:
            detail = res["errors"][0] if res["errors"] else "no rows changed"
            self._toast(f"{verb} did nothing: {detail}", error=True)

    def _on_sort_toggled(self, button: Gtk.RadioButton, mode: str) -> None:
        """Rebuild in whichever order was just picked.

        Guarded on `get_active()` because toggling one radio button in a group
        toggles the others off, and "toggled" fires for all of them. Reacting
        to the deactivations would reload three times per click, and the last
        reload would win -- so a click on "Start date" could leave the list
        ordered by whatever was switched away from.
        """
        if not button.get_active():
            return
        if mode == self.sort_mode:
            return
        self.sort_mode = mode
        self.reload()

    def _on_search_changed(self, entry: Gtk.SearchEntry) -> None:
        """Re-filter on every change the box reports.

        Connected to `search-changed`, not `changed`, and the difference is
        the debounce: SearchEntry emits from a ~150ms timer, so a fast typist's
        several keystrokes become ONE rebuild rather than one each.

        This docstring used to say "No debounce", on the argument that a delay
        makes the box feel unresponsive. That was written against `changed` and
        never revisited when the signal changed -- so it described the opposite
        of what the code does, and argued for something the chosen signal had
        already decided. The list is a few hundred rows at most, and reload() is
        a rebuild of widgets already in memory, so there is no cost worth that
        argument anyway.

        The cost of the debounce is in the TESTS, not the window: the signal
        does not fire from `set_text()`, so a test that sets the box without
        running the main loop measures a window with no filter on it. See
        `settle()` in test-popup-gui.py.
        """
        self.query = entry.get_text()
        self.reload()

    def _on_focus_in(self, *_args) -> bool:
        """
        Deliberately does nothing.

        This used to reload the database on every focus-in, to catch writes made
        elsewhere -- by the agent, the plugin, or OpenCode's own UI. It was
        removed because reload() ends in show_all(), which re-maps the widgets
        and can shift focus, which fires focus-in again. That is a feedback
        loop, and it showed as the window re-rendering continuously.

        It was also solving the wrong problem. The staleness that mattered was in the
        desktop app's own session list, which no code in this window can
        refresh -- see the note in the banner. This window's list is correct:
        it reloads after every write it makes, and re-reads the database on
        launch. A window left open across someone else's write shows that write
        on the next archive, restore, or reopen.
        """
        return False

    def _toast(self, text: str, error: bool = False) -> None:
        dlg = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.CLOSE,
            text=text,
        )
        dlg.connect("response", lambda w, *_: w.destroy())
        dlg.show_all()

    def _copy_id(self, session_id: str) -> None:
        """
        Put a session id on the clipboard.

        No button calls this any more. It was there from the popup's first
        commit, back when the numbered menus printed ids for you to copy, and
        nothing had replaced it — but the id is already on screen under every
        title, and this was the weakest of seven buttons. Kept because it is
        five lines and is the only clipboard route to an id if one is ever
        wanted again; deleting it would also mean deleting the decision.
        """
        clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clip.set_text(session_id, -1)
        clip.store()
        self.status.set_text(f"Copied {session_id}")

    def _show_stats(self, d: dict) -> None:
        """Open the per-session report in its own window."""
        stats = session_stats(self.store, d["id"])
        report = StatsWindow(
            f"Session — {d['title'] or '(untitled)'}",
            session_sections(stats),
            f"{_mb(stats.get('bytes', 0))} · {stats.get('messages', 0):,} messages"
            f" · opened from this window",
        )
        report.show_all()

    def _show_database_stats(self) -> None:
        """
        Open the whole-store report.

        Deliberately in the footer rather than on every row: the database is not
        a property of any one session, and a per-row button for it would imply
        it were. Eight buttons in a FlowBox also risks the one-per-line stack
        this window's own notes warn about.
        """
        report = StatsWindow(
            "OpenCode database",
            database_sections(database_stats(self.store), self.store),
            f"{self.store.path}",
        )
        report.show_all()

    def _show_architecture(self) -> None:
        """
        Open a window with the architecture diagram from markdown.
        
        Shows how OpenCode fits together on this machine: Hyprland, the desktop
        app, the Rust server, the plugin host, the Python GTK windows, the
        SQLite database, and the LLM provider. Read-only, nothing writes.
        """
        # Path to the cleaned up architecture markdown file
        arch_md = Path(__file__).resolve().parent.parent.parent / "opencode-architecture.md"
        
        if arch_md.exists():
            # Launch info-window with the markdown file (renders ASCII diagram properly)
            import subprocess
            subprocess.Popen(
                ["setsid", "info-window", "--title", "OpenCode Architecture", "--format", "markdown", str(arch_md)],
                start_new_session=True
            )
        else:
            # Fallback to text version
            arch_path = Path(__file__).resolve().parent.parent.parent / "opencode-architecture.md"
            if arch_path.exists():
                body = arch_path.read_text(encoding="utf-8")
            else:
                body = "Architecture diagram not found"
            
            report = StatsWindow(
                "OpenCode Architecture",
                [("ARCHITECTURE", body)],
                "How the pieces connect on this laptop",
            )
            report.show_all()

    def _save_transcript(self, data: dict) -> None:
        """
        Write the full transcript to ~/Downloads/<session_name>.md

        The path is reported in the status line and in the confirmation, because
        a save you cannot find is not much of a save. ~/Downloads rather than
        ~/Documents because that is where a file is wanted afterwards, not
        worked on.

        The filename is slugified from the title, and two sessions sharing a
        title therefore write the same file -- the second overwrites the first.
        That is flagged in the confirmation when it happens rather than silently
        clobbering, since losing a transcript to a name collision is exactly
        the failure this button is meant to prevent.
        """
        out_dir = self._out_dir()
        target = out_dir / f"{slug_of(data['title'])}.md"
        # Images go in a folder named after the transcript, and are referenced
        # from it relatively -- `![](Title-images/001-image.png)`. That is what
        # makes them render when the .md is opened, and it keeps the Downloads
        # folder from filling with loose screenshots.
        assets = out_dir / f"{target.stem}-images"

        try:
            text, images, skipped = read_transcript(
                self.store, data["id"], assets_dir=assets)
        except Exception as err:  # noqa: BLE001 - surfaced to the user
            self._toast(f"Could not read transcript: {err}", error=True)
            return

        header = (
            f"# {data['title'] or '(untitled)'}\n\n"
            f"- session: `{data['id']}`\n"
            f"- directory: `{data['directory'] or '-'}`\n"
            f"- updated: {stamp(data['time_updated'])}\n"
            f"- messages: {data['messages'] if data['messages'] is not None else '?'}\n"
            f"- archived: {'yes' if data['archived'] else 'no'}\n\n---\n\n"
        )
        existed = target.exists()
        target.write_text(header + text, encoding="utf8")

        shown = short_home(target)
        bits = []
        if images:
            bits.append(f"{images} image(s) in {assets.name}/")
        if skipped:
            bits.append(f"{skipped} could not be extracted")
        tail = f"  ·  {', '.join(bits)}" if bits else ""

        if existed:
            # The previous transcript of a same-titled session is gone. Say so
            # rather than leaving the user to find out later.
            self.status.set_text(f"Overwrote {shown}{tail}")
            self._toast(
                f"Overwrote {shown}{tail}\n\nAnother session already had this "
                "title, so its transcript was replaced. Rename one of them "
                "first if you need to keep both."
            )
        else:
            self.status.set_text(f"Saved {shown}{tail}")
            if images:
                self._toast(
                    f"Saved {shown}\n\n{tail.replace('  ·  ', '')} — "
                    f"they render when you open the .md."
                )

    def _export_json(self, data: dict) -> None:
        """
        Write OpenCode's own JSON export to ~/Downloads/<title>.json.

        Archive and restore are direct writes to this database, so they work
        only on this machine. This is the one export that leaves: the file is
        what `opencode session import` reads back, on this machine or another.

        The payload comes from `opencode session export` rather than from
        hand-assembling JSON here. The import format is the CLI's to define, it
        has already changed between releases, and a guess at it that is one
        field out produces a file that imports to an empty session -- which is
        worse than no export, because it looks like it worked.

        Exported to a temporary file first and moved into place, so a session
        that fails halfway does not leave a truncated .json sitting in
        Downloads looking importable.
        """
        tmp = None
        try:
            with tempfile.NamedTemporaryFile(
                "wb", suffix=".json", dir=self._out_dir(), delete=False
            ) as handle:
                tmp = Path(handle.name)
                proc = subprocess.run(
                    ["opencode", "session", "export", data["id"]],
                    stdout=handle,
                    stderr=subprocess.PIPE,
                    timeout=300,
                    check=False,
                )
            if proc.returncode != 0:
                raise RuntimeError(
                    proc.stderr.decode("utf8", "replace").strip()
                    or f"opencode exited {proc.returncode}"
                )

            target = self._out_dir() / f"{slug_of(data['title'])}.json"
            target.write_bytes(tmp.read_bytes())
        except subprocess.TimeoutExpired:
            self._toast("Export timed out after 5 minutes. Nothing was written.", error=True)
            return
        except Exception as err:  # noqa: BLE001 - surfaced to the user
            self._toast(f"Could not export session: {err}", error=True)
            return
        finally:
            if tmp is not None and tmp.exists():
                tmp.unlink(missing_ok=True)

        self.status.set_text(f"Exported {short_home(target)}")
        self._toast(
            f"Exported {short_home(target)}\n\n"
            "Bring it back with:\n"
            f"    opencode session import {short_home(target)}"
        )

    def _out_dir(self) -> Path:
        """Where exports and transcripts land: ~/Downloads, created on demand."""
        out = Path.home() / "Downloads"
        out.mkdir(parents=True, exist_ok=True)
        return out

    def _delete_session(self, data: dict) -> None:
        """
        Delete the session permanently, after an explicit confirmation.

        Deletion is the one action here with no way back: archiving is
        reversible from this window, saving leaves a copy elsewhere, and this
        removes the rows. So it asks first, names the session it is about to
        remove, and defaults to Cancel.

        The suggestion -- archive instead -- is on the dialog because the
        reversible action is almost always what was meant, and a confirmation
        that only offers the destructive choice is a confirmation that will be
        reflexively accepted.
        """
        title = data["title"] or "(untitled)"
        messages = data["messages"]
        count = f"{messages} messages" if messages is not None else "unknown number of messages"
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE,
            text=f"Permanently delete this session?\n\n{title}\n{count}",
        )
        cancel = dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        archive = dialog.add_button("Archive instead", RESP_ARCHIVE_INSTEAD)
        delete = dialog.add_button("Delete", RESP_DELETE)
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        # Focus Cancel, not Delete: Enter should never be the destructive path.
        dialog.set_focus(cancel)
        dialog.connect("response", self._on_delete_response, data)
        dialog.show_all()

    def _on_delete_response(self, dialog, response: int, data: dict) -> None:
        dialog.destroy()
        if response == RESP_ARCHIVE_INSTEAD:
            # Archive instead: reversible, and does the same tidying job.
            self._act(data["id"], archive=True)
            self._toast(
                "Palette is stale — restart OpenCode (opencode reload) to sync",
                error=False
            )
            return
        if response != RESP_DELETE:
            return

        try:
            removed = delete_session(self.store, data["id"])
        except Exception as err:  # noqa: BLE001 - surfaced to the user
            self._toast(f"Could not delete session: {err}", error=True)
            return

        if removed:
            self.reload()
            self.status.set_text(f"Deleted {data['title'] or data['id']}")
            self._toast(
                "Palette is stale — restart OpenCode (opencode reload) to sync",
                error=False
            )
        else:
            self._toast("Nothing was deleted.", error=True)

    def set_font_size(self, size: int, persist: bool = True) -> None:
        """
        Change the text size now, and remember it for the next window.

        The CSS is reloaded rather than a provider added, because
        `add_provider_for_screen` *stacks* providers -- adding one per press
        would leave every previous one in place, and the text would only ever
        grow no matter how many times Reset was clicked.
        """
        size = max(FONT_MIN, min(FONT_MAX, size))
        if size == self.font_size:
            return
        self.font_size = size
        self._css.load_from_data(scaled_css(CSS, size))
        # The banner's wrap width is in characters and the text just changed
        # size, so it has to be re-derived. Missed this the first time, and a
        # window opened at a large saved size came out 3778px wide.
        if getattr(self, "banner_label", None) is not None:
            _cols = banner_cols(size)
            self.banner_label.set_width_chars(_cols)
            self.banner_label.set_max_width_chars(_cols)
        if persist:
            save_font_size(size)

    def on_key(self, _widget, event) -> bool:
        if event.keyval == Gdk.KEY_F5:
            # Kept as an undocumented convenience even though there is no
            # Refresh button. Harmless, and useful when debugging a stale read.
            self.reload()
            return True
        ctrl = event.state & Gdk.ModifierType.CONTROL_MASK
        if ctrl and event.keyval in (Gdk.KEY_plus, Gdk.KEY_equal,
                                     Gdk.KEY_KP_Add):
            self.set_font_size(self.font_size + FONT_STEP)
            return True
        if ctrl and event.keyval in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
            self.set_font_size(self.font_size - FONT_STEP)
            return True
        if ctrl and event.keyval in (Gdk.KEY_0, Gdk.KEY_KP_0, Gdk.KEY_KP_Insert):
            self.set_font_size(FONT_DEFAULT)
            return True
        if event.keyval == Gdk.KEY_Escape:
            # In the search box, Escape clears it rather than closing the
            # window. SearchEntry swallows Escape itself when it is focused, so
            # this only fires for the list -- but the ordering matters: a
            # second Escape on a filtered list would otherwise take out the
            # window and lose the filter along with it.
            if self.search.get_text():
                self.search.set_text("")
                return True
            row = self.listbox.get_selected_row()
            if row is not None:
                # First Escape closes the action strip, second closes the window.
                self._dismiss()
                return True
            self.destroy()
            return True
        return False


def data_title(session_id: str, store: Store) -> str:
    for d in store.list():
        if d["id"] == session_id:
            return d["title"] or "(untitled)"
    return session_id


def delete_session(store: Store, session_id: str) -> bool:
    """
    Remove one session and every row that belongs to it. True if it went.

    This is the only operation in this window without a way back: archiving is
    reversible here, saving and exporting leave a file elsewhere, and this
    deletes. So it snapshots first, and it deletes in one transaction -- either
    the session and all of its messages go, or none of it does. A half-deleted
    session, with a title in the list and no conversation under it, would be
    worse than either outcome.

    Which tables are touched is discovered rather than assumed: every table
    carrying a `session_id` column, which is how session data is keyed
    throughout this schema. A table without that column is left alone even if
    it plausibly belongs to the session -- `event` is keyed by `aggregate_id`
    and belongs to the running server, and guessing at its contents is how a
    delete turns into data loss somewhere else.

    The live session is refused here, not only by a disabled button, on the
    same reasoning as archiving: you cannot remove the conversation you are
    standing in from a window that is part of it.

    Both refusals -- live session, unknown id -- are checked BEFORE the
    snapshot. Snapshotting first meant every refused delete still consumed one
    of the three retained backups, so three refusals would push out the very
    snapshot that holds the session a real delete removed. The checks are
    repeated inside the write transaction, since VACUUM INTO cannot run inside
    one and the state could change in between.
    """
    db = store._connect()  # noqa: SLF001 - same module family
    try:
        db.execute("PRAGMA busy_timeout = 15000")
        if store._is_live(db, session_id):  # noqa: SLF001 - same module family
            raise ValueError(
                "this is the session currently open in OpenCode, and "
                "cannot be deleted from here"
            )
        if db.execute(f"SELECT 1 FROM {store.table} WHERE id = ?", (session_id,)).fetchone() is None:
            return False

        have = {
            r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")
        }
        targets = []
        for table in sorted(have):
            if not table.replace("_", "").isalnum():
                continue  # a quoted or odd name is not worth the risk
            cols = {r[1] for r in db.execute(f"PRAGMA table_info({table})")}
            if "session_id" in cols or table == store.table:
                targets.append(table)
    finally:
        db.close()

    store.backup()

    db = store._connect()  # noqa: SLF001 - same module family
    try:
        db.execute("PRAGMA busy_timeout = 15000")
        db.execute("BEGIN IMMEDIATE")
        try:
            # Re-checked inside the transaction: the snapshot took time, and
            # this is the write that actually happens.
            if store._is_live(db, session_id):  # noqa: SLF001 - same module family
                raise ValueError(
                    "this is the session currently open in OpenCode, and "
                    "cannot be deleted from here"
                )
            row = db.execute(
                f"SELECT 1 FROM {store.table} WHERE id = ?", (session_id,)
            ).fetchone()
            if row is None:
                db.execute("ROLLBACK")
                return False

            removed = 0
            # Children first. There are no foreign keys declared here, but the
            # order keeps this correct if a future release adds them.
            for table in [t for t in targets if t != store.table]:
                cur = db.execute(f"DELETE FROM {table} WHERE session_id = ?", (session_id,))
                removed += cur.rowcount
            cur = db.execute(f"DELETE FROM {store.table} WHERE id = ?", (session_id,))
            removed += cur.rowcount
            db.execute("COMMIT")
            return removed > 0
        except Exception:
            db.execute("ROLLBACK")
            raise
    finally:
        db.close()


def read_transcript(store: Store, session_id: str, limit: int = 0,
                    assets_dir: Path | None = None) -> tuple[str, int, int]:
    """
    Pull displayable text out of a session, oldest first.

    Returns `(markdown, images_written, images_skipped)`.

    IMAGES

    A pasted screenshot is stored inline as base64 in the message's `files`
    list -- about 200KB of PNG per paste -- and not in a `part` row. Reading
    only `text` therefore drops every image silently, which is exactly what
    happened: a transcript of a session with four screenshots in it contained
    none of them.

    With `assets_dir` given, each inline image is decoded to a file beside the
    transcript and referenced from the Markdown with a relative path, which is
    what makes it render in Okular, Obsidian or a browser. A base64 blob cannot
    be shown in a Markdown document; it has to become a file first.

    Without `assets_dir` -- the `--text` and test callers -- images are noted in
    the body as a placeholder rather than dropped without trace, so a reader can
    see that something was there.

    Skips are counted and reported rather than raising: an image whose MIME type
    is unrecognised, or whose payload is not decodable, is a line of text rather
    than a failed save.

    Capped at MAX_IMAGES because a session can hold hundreds of pastes and the
    point of the button is a readable transcript, not a disk image. The cap is
    stated in the output when it bites.
    """
    db = store._connect()  # noqa: SLF001 - same module family
    written = skipped = 0
    try:
        have = {
            r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")
        }
        table = next((t for t in ("session_message", "message") if t in have), None)
        if not table:
            return "(no message table)", 0, 0
        cols = {r[1] for r in db.execute(f"PRAGMA table_info({table})")}
        if "session_id" not in cols:
            return "(no session_id column)", 0, 0

        order = "seq ASC" if "seq" in cols else (
            "time_created ASC" if "time_created" in cols else "rowid ASC"
        )
        type_col = "type" if "type" in cols else "''"

        out = []
        for mtype, raw in db.execute(
            f"SELECT {type_col}, data FROM {table} WHERE session_id = ? ORDER BY {order}",
            (session_id,),
        ):
            import json

            try:
                parsed = json.loads(raw)
            except Exception:  # noqa: BLE001
                continue
            text = ""
            if mtype == "user":
                meta = parsed.get("metadata") or {}
                text = meta.get("displayText") or parsed.get("text") or ""
            elif mtype == "assistant":
                parts = parsed.get("content") or []
                text = "\n\n".join(
                    p.get("text", "") for p in parts if p.get("type") == "text"
                )
            elif mtype == "synthetic":
                text = parsed.get("text") or ""

            # Images live on the message, not inside its text, so they are read
            # for every message type rather than only the user's -- an assistant
            # turn can carry a screenshot back.
            notes = []
            for attachment in (parsed.get("files") or parsed.get("attachments") or []):
                note, made, miss = _image_markdown(
                    attachment, written + skipped, assets_dir, MAX_IMAGES)
                written += made
                skipped += miss
                if note:
                    notes.append(note)

            text = (text or "").strip()
            if not text and not notes:
                continue
            label = {"user": "You", "assistant": "Assistant"}.get(mtype, mtype)
            body = "\n\n".join([text, *notes]) if text else "\n\n".join(notes)
            out.append(f"### {label}\n\n{body}")

        if written + skipped >= MAX_IMAGES:
            out.append(
                f"### Note\n\n{skipped} further image(s) were not extracted; "
                f"the limit is {MAX_IMAGES} per transcript."
            )

        body = "\n\n".join(out)
        return (body if limit <= 0 else body[-limit:]), written, skipped
    finally:
        db.close()


# How many inline images to extract per transcript. High enough that an ordinary
# session is complete, low enough that a paste-heavy one cannot fill the disk
# from one click.
MAX_IMAGES = 50


def _image_markdown(attachment: dict, index: int, assets_dir: Path | None,
                    limit: int) -> tuple[str, int, int]:
    """
    Turn one attachment into a Markdown line.

    Returns `(line, written, skipped)`. `line` is empty when the attachment is
    not an image at all -- a pasted file path, say -- because those are text and
    belong in the body rather than being written beside it.
    """
    mime = (attachment.get("mime") or attachment.get("mimeType") or "").lower()
    if mime and not mime.startswith("image/"):
        return "", 0, 0

    ext = {"image/png": ".png", "image/jpeg": ".jpg", "image/gif": ".gif",
           "image/webp": ".webp"}.get(mime, ".png")
    name = (attachment.get("name") or "").strip()
    stem = "".join(c if c.isalnum() or c in "-_" else "-" for c in name).strip("-")

    if assets_dir is None:
        kb = len(attachment.get("data") or "") * 3 // 4 // 1024
        return (f"*[image: {name or 'screenshot'}, {mime or 'unknown type'}, "
                f"~{kb} KB — extract with Transcript.md]*"), 0, 0

    if index >= limit:
        return "", 0, 1

    # Try base64 `data` first (pasted screenshots), then `path` (chat upload button).
    payload = attachment.get("data") or ""
    blob = None
    if payload:
        # Tolerate a data: URL prefix; the payload is bare base64 today but this
        # costs nothing and would not have been true on every release.
        payload = payload.split(",", 1)[1] if payload.startswith("data:") else payload
        try:
            blob = base64.b64decode(payload, validate=False)
        except Exception:  # noqa: BLE001
            blob = None

    if blob is None:
        # Fall back to reading a local file from `path` (chat file upload).
        path_str = attachment.get("path") or ""
        if path_str:
            try:
                # Expand ~ and resolve relative to cwd
                path = Path(path_str).expanduser()
                if not path.is_absolute():
                    path = Path.cwd() / path
                blob = path.read_bytes()
            except Exception:  # noqa: BLE001
                blob = None

    if blob is None:
        return "", 0, 1

    filename = f"{index + 1:03d}-{stem or 'image'}{ext}"
    try:
        assets_dir.mkdir(parents=True, exist_ok=True)
        (assets_dir / filename).write_bytes(blob)
    except OSError:
        return f"*[image: {name or 'image'} — could not be written]*", 0, 1

    alt = stem or "screenshot"
    return f"![{alt}]({assets_dir.name}/{filename})", 1, 0


def main() -> int:
    ap = argparse.ArgumentParser(description="OpenCode session inventory")
    ap.add_argument("--copy", action="store_true", help="print to stdout, no window")
    ap.add_argument("--db", help="path to opencode.db (default: the real one)")
    ap.add_argument(
        "--current",
        help=(
            "session id to mark as the live one, and refuse to archive or "
            "delete. The plugin passes this. Without it the window falls back "
            "to OpenCode's time_suspended timestamp, which is a guess."
        ),
    )
    args = ap.parse_args()

    store = Store(Path(args.db) if args.db else default_db(), current=args.current)

    if args.copy:
        print(plain_text(store))
        return 0

    win = Window(store)
    win.show_all()

    # Belt and braces around Gtk.main()'s own exit-when-last-window-closes rule.
    #
    # That rule did not always fire: instances were surviving with no window
    # mapped, invisible but still running, and they stacked up one per launch
    # until they had to be killed by hand. So the main loop is driven explicitly
    # and quit from the destroy handler, and a watchdog exits the process if the
    # loop somehow outlives the window. A popup that cannot be closed is worse
    # than one that re-reads a little lazily.
    def quit_loop(*_args) -> bool:
        if Gtk.main_level() > 0:
            Gtk.main_quit()
        return False

    win.connect("destroy", quit_loop)

    def watchdog() -> bool:
        if not win.get_visible() and Gtk.main_level() > 0:
            Gtk.main_quit()
        return True

    GLib.timeout_add(2000, watchdog)

    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())