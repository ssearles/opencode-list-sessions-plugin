def _loads(row) -> dict:
    """Parse a message blob, or {} for anything unreadable."""
    try:
        value = json.loads(row[0])
        return value if isinstance(value, dict) else {}
    except (TypeError, ValueError):
        return {}


def _mb(n: int) -> str:
    if n >= 1048576:
        return f"{n / 1048576:,.1f} MB"
    if n >= 1024:
        return f"{n / 1024:,.0f} KB"
    return f"{n:,} B"


def _dur(ms: float) -> str:
    minutes = ms / 60000.0
    if minutes < 1:
        return f"{ms / 1000:.0f}s"
    if minutes < 90:
        return f"{minutes:.0f}m"
    if minutes < 1440:
        return f"{minutes / 60:.1f}h"
    return f"{minutes / 1440:.1f}d"


# A gap longer than this between two messages is you having stopped, not the
# agent thinking. Five minutes is the threshold because it is shorter than any
# break taken while still in a task, and longer than any pause while typing.
IDLE_GAP_MS = 5 * 60 * 1000


def session_stats(store: Store, session_id: str) -> dict:
    """
    Everything worth knowing about one session, as plain data.

    A function rather than a window so it can be tested without a display, and
    so the database-wide view can reuse the per-message walk.

    Cost is reported even though it reads $0.00 on a free model. The column is
    written by OpenCode for every session and will not stay zero if the account
    ever buys tokens or moves to a metered model, at which point this becomes
    the number that decides which sessions were expensive. Showing it now means
    the number is there when it starts meaning something, instead of the
    feature needing to grow a cost section at the worst possible moment.
    """
    db = store._connect()  # noqa: SLF001 - same module, and one shared connection
    rows = list(db.execute(
        "SELECT type, data FROM session_message WHERE session_id = ? ORDER BY seq",
        (session_id,)))
    head = db.execute(
        f"SELECT title, directory, cost, tokens_input, tokens_output, "
        f"tokens_reasoning, tokens_cache_read, tokens_cache_write, model, "
        f"agent, time_created, time_updated, time_archived, resume_attempts, "
        f"time_idle, idle_outcome, slug "
        f"FROM {store.table} WHERE id = ?", (session_id,)).fetchone()
    if head is None:
        return {}

    out: dict = {
        "id": session_id,
        "title": head[0] or "(untitled)",
        "directory": head[1],
        "cost": head[2] or 0.0,
        "tokens": {
            "input": head[3] or 0, "output": head[4] or 0,
            "reasoning": head[5] or 0,
            "cache_read": head[6] or 0, "cache_write": head[7] or 0,
        },
        "model": head[8], "agent": head[9],
        "created": head[10], "updated": head[11], "archived": head[12],
        "resume_attempts": head[13] or 0,
        "idle_outcome": head[15], "slug": head[16],
        "messages": len(rows),
        "bytes": sum(len(r[1] or "") for r in rows),
    }

    kinds: Counter = Counter()
    tools: Counter = Counter()
    files: Counter = Counter()
    models: Counter = Counter()
    errors = 0
    compactions = 0
    switches = 0
    biggest = []
    running = out["tokens"]["input"]

    for kind, raw in rows:
        j = _loads((raw,))
        kinds[kind or "unknown"] += 1
        if kind == "compaction":
            compactions += 1
        if kind == "model-switched":
            switches += 1
        if j.get("cost"):
            running += j["cost"] or 0
        if j.get("error"):
            errors += 1
        if kind == "assistant" and j.get("model"):
            models[j["model"].get("id") or "?"] += 1
        for part in j.get("content") or []:
            if not isinstance(part, dict) or part.get("type") != "tool":
                continue
            tools[part.get("name") or "?"] += 1
            state = part.get("state") or {}
            if state.get("status") == "error":
                errors += 1
            given = state.get("input") or {}
            for key in ("filePath", "path", "file"):
                if given.get(key):
                    files[str(given[key])] += 1
                    break
        biggest.append((len(raw or ""), (j.get("text") or "")[:90]
                        or next((str(p.get("text", ""))[:90]
                                 for p in j.get("content") or []
                                 if isinstance(p, dict)
                                 and p.get("type") == "text"), "")))

    out["kinds"] = dict(kinds)
    out["tools"] = tools
    out["files"] = files
    out["models"] = dict(models)
    out["tool_calls"] = sum(tools.values())
    out["errors"] = errors
    out["compactions"] = compactions
    out["switches"] = switches
    out["biggest"] = sorted(biggest, reverse=True)[:3]

    # Active time from the gaps. Wall clock is what the row already implies and
    # it is mostly sleep: the laptop session spans ten days and was worked on
    # for hours, so "how long did this take" needs the difference between the
    # two to mean anything.
    times = [j["time"]["created"] for _kind, raw in rows
             for j in [_loads((raw,))]
             if isinstance(j.get("time"), dict) and j["time"].get("created")]
    times.sort()
    active = 0
    for earlier, later in zip(times, times[1:]):
        active += min(later - earlier, IDLE_GAP_MS)
    out["wall_ms"] = ((out["updated"] - out["created"])
                      if (out["created"] and out["updated"]) else 0)
    out["active_ms"] = active
    out["first_msg"] = times[0] if times else None
    out["last_msg"] = times[-1] if times else None
    return out


def database_stats(store: Store) -> dict:
    """
    The whole store, for "is any of this getting out of hand?".

    Size is the headline because it is the only figure that changes what
    somebody does next. Counts and cost are context for it.

    Every message is parsed once here rather than per session, because the
    per-session view calls this function for one session and the obvious
    implementation -- loop the sessions, call session_stats on each -- re-reads
    and re-parses the entire database once per row. At a few thousand messages
    that is the difference between a window and a hang.
    """
    db = store._connect()  # noqa: SLF001 - one shared read
    totals = Counter()
    per_session: Counter = Counter()
    files: Counter = Counter()
    tools: Counter = Counter()
    models: Counter = Counter()
    kinds: Counter = Counter()

    for sid, kind, raw in db.execute(
            "SELECT session_id, type, data FROM session_message ORDER BY seq"):
        size = len(raw or "")
        per_session[sid] += size
        totals["bytes"] += size
        totals["messages"] += 1
        j = _loads((raw,))
        kinds[kind or "unknown"] += 1
        if j.get("type") == "assistant" and j.get("model"):
            models[j["model"].get("id") or "?"] += 1
        for part in j.get("content") or []:
            if not isinstance(part, dict) or part.get("type") != "tool":
                continue
            tools[part.get("name") or "?"] += 1
            given = (part.get("state") or {}).get("input") or {}
            for key in ("filePath", "path", "file"):
                if given.get(key):
                    files[str(given[key])] += 1
                    break

    rows = db.execute(
        f"SELECT id, title, time_archived, cost, tokens_input, tokens_output, "
        f"tokens_reasoning, tokens_cache_read, time_created FROM {store.table}"
    ).fetchall()

    on_disk = store.path.stat().st_size if store.path.exists() else 0
    for suffix in ("-wal", "-shm"):
        side = store.path.with_name(store.path.name + suffix)
        if side.exists():
            on_disk += side.stat().st_size

    backups = 0
    backup_count = 0
    bdir = store.path.parent / "backups"
    if bdir.is_dir():
        for b in bdir.glob("*.db"):
            backups += b.stat().st_size
            backup_count += 1

    cost = sum(r[3] or 0 for r in rows)
    tokens = {
        "input": sum(r[4] or 0 for r in rows),
        "output": sum(r[5] or 0 for r in rows),
        "reasoning": sum(r[6] or 0 for r in rows),
        "cache_read": sum(r[7] or 0 for r in rows),
    }

    return {
        "sessions": len(rows),
        "archived": sum(1 for r in rows if r[2] is not None),
        "messages": totals["messages"],
        "message_bytes": totals["bytes"],
        "on_disk": on_disk,
        "backups_bytes": backups,
        "backups_count": backup_count,
        "cost": cost,
        "tokens": tokens,
        "kinds": dict(kinds),
        "tools": tools,
        "files": files,
        "models": dict(models),
        "sizes": {r[0]: (r[1] or "(untitled)", per_session.get(r[0], 0))
                  for r in rows},
        "created_range": (min((r[8] for r in rows if r[8]), default=None),
                          max((r[8] for r in rows if r[8]), default=None)),
    }


def by_date(rows: list[dict], field: str = "time_updated") -> list[dict]:
    """
    Sort session rows by a timestamp, newest first.

    `field` is `time_created` or `time_updated` -- the two dates worth ordering
    by, and both already selected by the store. They answer different
    questions, which is why both are offered: a session started last Tuesday
    and finished an hour ago sits at the top of one list and near the bottom
    of the other, and which one you want depends on whether you are after "what
    did I begin" or "what did I last leave off".

    Newest-first because the reason to reach for this is almost always "what
    did I work on lately" -- an oldest-first list buries today's work at the
    bottom, which is the opposite of the point.

    `id` breaks the tie, for the same reason by_name() does: a list that
    reshuffles between two refreshes is unreadable while you are reaching for a
    row in it. Rows with no timestamp sort last rather than first, matching
    by_name()'s handling of untitled rows -- an absent value is nothing to
    order by, so it goes where it is visible rather than where it wins.
    """
    return sorted(
        rows,
        key=lambda d: (
            not (d.get(field) or 0),
            -(d.get(field) or 0),
            d.get("id") or "",
        ),
    )


def matches(d: dict, terms: list[str]) -> bool:
    """
    True when every term appears somewhere in this session.

    All of title, id and directory are searched, not just the title. The title
    is what people remember, but the id is what arrives in a terminal, and the
    directory is how a session from another project gets found at all -- this
    window lists every session on the machine, so most rows are not even in the
    folder you are sitting in.

    Terms are ANDed, not ORed. Typing two words is a narrowing, and treating
    the second as an alternative makes the list grow as you type, which is the
    behaviour that makes people distrust a search box.
    """
    hay = " ".join(
        str(d.get(field) or "") for field in ("title", "id", "directory")
    ).lower()
    return all(t in hay for t in terms)


def filter_rows(rows: list[dict], query: str) -> list[dict]:
    """
    Narrow `rows` to the ones a search box's text selects.

    Whitespace splits the query into terms, so "job 8" means both. An empty or
    whitespace-only query matches everything rather than nothing, which is what
    makes clearing the box restore the full list without a special case.
    """
    terms = [t for t in (query or "").lower().split() if t]
    if not terms:
        return list(rows)
    return [d for d in rows if matches(d, terms)]


def stamp(ms) -> str:
    if not ms:
        return "-"
    return datetime.datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M")


def default_db() -> Path:
    base = os.environ.get("XDG_DATA_HOME")
    root = Path(base) if base else Path.home() / ".local" / "share"
    return root / "opencode" / "opencode.db"


class Store:
    """
    Read/write access to the session table.

    Schema-agnostic in the same way the plugin is: the table is discovered
    (`session_v2` preferred over `session`) and its columns introspected, so a
    release that adds or drops a column degrades instead of throwing.
    """

    RETAIN = 3

    def __init__(self, path: Path, current: str | None = None):
        self.path = path
        # The session this window was opened from, when the plugin told us.
        # Authoritative; see resolve_live() for what happens without it.
        #
        # Normalised with `or None` because two methods read this and they
        # disagreed about an empty string: list() asks `if not live_id` and
        # _is_live() asks `is not None`. An empty `--current` therefore marked a
        # row in the UI while the write path refused nothing -- the window said
        # "cannot be archived" about a row it would happily archive. Collapsing
        # it here means both readers see the same thing for every input.
        self.current = current or None
        if not path.exists():
            raise SystemExit(f"No database at {path}")
        self._connect().close()  # fail fast and clearly
        self.table, self.columns = self._detect()

    def _connect(self) -> sqlite3.Connection:
        return sqlite3.connect(self.path, timeout=15.0)

    def _detect(self) -> tuple[str, set[str]]:
        db = self._connect()
        try:
            have = {
                r[0]
                for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")
            }
            for candidate in ("session_v2", "session"):
                if candidate in have:
                    cols = {r[1] for r in db.execute(f"PRAGMA table_info({candidate})")}
                    return candidate, cols
            raise SystemExit(
                "No session table found. Looked for session_v2 and session; "
                f"found: {', '.join(sorted(have)) or 'nothing'}."
            )
        finally:
            db.close()

    # ---------------------------------------------------------------- reads

    def _message_expr(self, db: sqlite3.Connection) -> str:
        """A per-session message count, or NULL if no message table is usable."""
        have = {
            r[0]
            for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")
        }
        for table in ("session_message", "message", "message_part"):
            if table not in have:
                continue
            cols = {r[1] for r in db.execute(f"PRAGMA table_info({table})")}
            if "session_id" in cols:
                return f"(SELECT COUNT(*) FROM {table} WHERE session_id = s.id)"
        return "NULL"

    def list(self, archived: str = "all") -> list[dict]:
        """
        Sessions ordered the way the plugin orders them.

        `ORDER BY time_updated DESC` puts the most recently touched session
        first, which is the order the window shows and the order archiving
        reshuffles. Do not "improve" this into a different sort.
        """
        if "time_archived" not in self.columns:
            raise SystemExit(f"Table {self.table} has no time_archived column.")

        db = self._connect()
        try:
            col = lambda n: (f"s.{n}" if n in self.columns else "NULL")  # noqa: E731
            order = "time_updated" if "time_updated" in self.columns else "time_created"

            sql = (
                f"SELECT s.id AS id, {col('title')} AS title, "
                f"{col('directory')} AS directory, {col('time_created')} AS time_created, "
                f"{col('time_updated')} AS time_updated, s.time_archived AS time_archived, "
                f"{col('time_suspended')} AS time_suspended, "
                f"{self._message_expr(db)} AS messages FROM {self.table} s"
            )
            if archived == "only":
                sql += " WHERE s.time_archived IS NOT NULL"
            elif archived == "active":
                sql += " WHERE s.time_archived IS NULL"

            sql += f" ORDER BY s.{order} DESC"

            columns = (
                "id",
                "title",
                "directory",
                "time_created",
                "time_updated",
                "time_archived",
                "time_suspended",
                "messages",
            )
            out = []
            for raw in db.execute(sql):
                d = dict(zip(columns, raw))
                d["archived"] = d["time_archived"] is not None
                out.append(d)

            # Mark the session you are working in right now, so it cannot be
            # archived by accident from this window.
            #
            # Two ways to know, in order of trust:
            #
            # 1. `--current <id>`, which the plugin passes from the session the
            #    command was typed in. That is a fact: it is the session that
            #    opened this window, and it stays correct for as long as the
            #    window is open even if OpenCode moves its attention elsewhere.
            # 2. `time_suspended`, which OpenCode sets on the live session and
            #    leaves NULL on every other. A heuristic, and the only option
            #    when the window is launched by hand.
            #
            # The fallback matters less than it looks. It is also what makes the
            # failure mode of ignoring (1) a safety bug rather than a cosmetic
            # one: a wrong live row means Archive is disabled on the wrong
            # session and enabled on the one you are in, and the write path
            # refuses by the same test, so it agrees with the button. Both were
            # derived from one guess, so the guess being wrong is enough.
            live_id = self.current
            if not live_id:
                live = max(
                    (d for d in out if d.get("time_suspended")),
                    key=lambda d: d["time_suspended"],
                    default=None,
                )
                live_id = live["id"] if live else None
            for d in out:
                d["is_live"] = d["id"] == live_id
            return out
        finally:
            db.close()

    # --------------------------------------------------------------- writes

    def _backup_dir(self) -> Path:
        return self.path.parent / "backups"

    def backup(self) -> Path:
        """Snapshot with VACUUM INTO, then trim to RETAIN.

        VACUUM INTO rather than a file copy because it is consistent even while
        OpenCode holds the source open in WAL mode. It refuses to overwrite, so
        pick the first free name.
        """
        target_dir = self._backup_dir()
        target_dir.mkdir(parents=True, exist_ok=True)

        base = self.path.name.removesuffix(".db")
        stamp_txt = datetime.datetime.now().strftime("%Y%m%d%H%M%S")
        target = target_dir / f"{base}.backup-{stamp_txt}.db"
        n = 1
        while target.exists():
            target = target_dir / f"{base}.backup-{stamp_txt}-{n}.db"
            n += 1

        db = self._connect()
        try:
            db.execute("VACUUM INTO ?", (str(target),))
        finally:
            db.close()

        self._prune()
        return target

    def _prune(self) -> None:
        """Drop the oldest snapshots beyond RETAIN. Never fatal."""
        try:
            prefix = self.path.name.removesuffix(".db") + ".backup-"
            mine = sorted(
                (f for f in self._backup_dir().iterdir() if f.name.startswith(prefix)),
                key=lambda f: f.stat().st_mtime,
                reverse=True,
            )
            # Slice, not index. `mine[RETAIN]` raises IndexError whenever fewer
            # than RETAIN snapshots exist yet, which is every first few writes.
            for old in mine[self.RETAIN :]:
                old.unlink()
        except OSError:
            pass  # housekeeping, not worth failing a write over

    def set_archived(self, ids: list[str], archived: bool) -> dict:
        """Archive or restore. Returns changed ids, errors, and the backup."""
        unique = list(dict.fromkeys(i for i in ids if i))
        result = {"changed": [], "errors": [], "backup": None}
        if not unique:
            return result

        # Snapshot first. If the backup fails there is no write at all, which
        # is the safe direction to fail in.
        result["backup"] = self.backup()

        now = int(datetime.datetime.now().timestamp() * 1000)
        has_updated = "time_updated" in self.columns
        if archived:
            sql = f"UPDATE {self.table} SET time_archived = ? WHERE id = ?"
        elif has_updated:
            sql = f"UPDATE {self.table} SET time_archived = NULL, time_updated = ? WHERE id = ?"
        else:
            sql = f"UPDATE {self.table} SET time_archived = NULL WHERE id = ?"

        db = self._connect()
        try:
            db.execute("PRAGMA busy_timeout = 15000")
            db.execute("BEGIN IMMEDIATE")
            for sid in unique:
                try:
                    exists = db.execute(
                        f"SELECT 1 FROM {self.table} WHERE id = ?", (sid,)
                    ).fetchone()
                    if not exists:
                        result["errors"].append(f"{sid}: no such session")
                        continue

                    # Refuse to archive the live session, checked here rather
                    # than only in the UI. A disabled button is a courtesy; this
                    # is the rule. Without it, any caller of this method could
                    # archive the conversation the user is standing in.
                    if archived and self._is_live(db, sid):
                        result["errors"].append(
                            f"{sid}: this is the session currently open in "
                            "OpenCode, and cannot be archived from here"
                        )
                        continue

                    params = (now, sid) if (archived or has_updated) else (sid,)
                    cur = db.execute(sql, params)
                    if cur.rowcount > 0:
                        result["changed"].append(sid)
                    else:
                        result["errors"].append(f"{sid}: no rows changed")
                except sqlite3.Error as err:
                    result["errors"].append(f"{sid}: {err}")
            db.execute("COMMIT")
        except sqlite3.Error:
            db.rollback()
            raise
        finally:
            db.close()

        return result

    def _is_live(self, db: sqlite3.Connection, session_id: str) -> bool:
        """True when this session is the one currently open in OpenCode.

        Read inside the write transaction so the check cannot race with the
        update.

        Two sources, in the same order and for the same reasons as list(): the
        `--current` id the plugin passes, which is a fact, then OpenCode's
        `time_suspended` timestamp, which is a guess and is only consulted when
        the window was launched bare. See list() for why the timestamp cannot be
        trusted on its own -- it decides a safety rule here, and all three of
        its users derived from one guess, so a wrong guess disabled Archive on
        the wrong session and enabled it on the live one.
        """
        # `--current` wins over the timestamp for the same reason list() does: it is
        # the session this window was actually opened from. Checked before the
        # schema question, because a database without `time_suspended` must
        # still refuse to archive the session you are in.
        if self.current is not None:
            return session_id == self.current
        if "time_suspended" not in self.columns:
            return False
        row = db.execute(
            f"SELECT 1 FROM {self.table} WHERE id = ? AND time_suspended IS NOT NULL",
            (session_id,),
        ).fetchone()
        return row is not None


# --------------------------------------------------------------------- text


def plain_text(store: Store) -> str:
    """
    The same list as the window, for stdout and tests.

    Unnumbered, for the same reason the window is: the actions live on buttons, so
    there is nothing to type a number into, and the plugin's own `/list_sessions`
    is deliberately unnumbered too. Every line carries its full session id, which
    is unambiguous where a remembered position would not be.

    Ordered by DEFAULT_SORT, which is what the window opens on. The two are the
    same product and have said they agree for a while; sharing the constant is
    what keeps that true.
    """
    rows = store.list()
    default = next(o for o in SORTS if o[0] == DEFAULT_SORT)
    order = by_name if default[2] is None else lambda r: by_date(r, default[2])
    working = order([r for r in rows if not r["archived"]])
    archived = order([r for r in rows if r["archived"]])

    def block(heading: str, items: list[dict]) -> list[str]:
        if not items:
            return []
        lines = [f"{heading} ({len(items)})", ""]
        for d in items:
            msgs = d["messages"] if d["messages"] is not None else "?"
            lines.append(f"  {d['title'] or '(untitled)'}")
            bits = [f"{msgs} msg", stamp(d["time_updated"])]
            if d["directory"]:
                bits.append(short_dir(d["directory"]))
            # Same wording as the plugin's /list_sessions, so the two agree on
            # what state a row is in and what can be done to it.
            #
            # The live row says so rather than promising an Archive that the
            # write path will refuse. Text that offers an action the window
            # itself forbids is worse than text that names the state.
            if d.get("is_live"):
                state, action = "this session", "cannot be archived"
            else:
                action = "Restore" if d["archived"] else "Archive"
                state = "archived" if d["archived"] else "unarchived"
            bits.append(f"{state} · {action}")
            lines.append(f"     {d['id']}  ·  " + "  ·  ".join(bits))
        return lines

    out = block("Unarchived — right-click one to Archive", working)
    out += [""] + block("Archived — right-click one to Restore", archived)
    out += ["", "Run this without --copy for the window with Archive/Restore buttons."]
    return "\n".join(out).strip()


